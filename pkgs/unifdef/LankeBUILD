lankebuild_prepare() {
    echo "Preparing unifdef-{ORIG_PKG_VER}"
    # C23 将 constexpr 设为关键字，老代码用了同名标识符
    sed -i 's/\bconstexpr\b/const_expr/g' unifdef.c
}

lankebuild_build() {
    echo "Building unifdef-{ORIG_PKG_VER}"
    make -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging unifdef-{ORIG_PKG_VER}"
    make DESTDIR="{STAGING_ROOT}" prefix=/usr install
    echo "Package staging complete."
}
