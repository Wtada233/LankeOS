lankebuild_prepare() {
    :
}

lankebuild_build() {
    # 按运行中的 python 找 lanke-py-bootstrap 的树。找不到 = bootstrap 未针对该 python 验证过
    # → 响亮失败（而不是拿错版本的树静默装出一个坏包）
    local pyver="$(python -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')"
    local boot="/usr/share/lanke-py-bootstrap/${pyver}"
    if [ ! -d "$boot" ]; then
        echo "lanke-py-bootstrap 未为 python ${pyver} 提供树；现有：$(ls /usr/share/lanke-py-bootstrap/ 2>/dev/null | tr '\n' ' ')" >&2
        exit 1
    fi
    # 树在 /usr/share 下只读 → 拷到可写处（bootstrap.build 会往源码里写 egg-info 等）
    cp -a "$boot" {WORK_DIR}/boot
    cd {WORK_DIR}/boot
    python -m bootstrap.build -o {WORK_DIR}/dist
}

lankebuild_package() {
    # bootstrap.build 会把 7 个核心 wheel 都建出来，这里只装自己那个
    cd {WORK_DIR}/boot
    python -m bootstrap.install {WORK_DIR}/dist/setuptools-*.whl -d {STAGING_ROOT}
    find {STAGING_ROOT}/ -name "__pycache__" -type d -exec rm -rf {} +
}
