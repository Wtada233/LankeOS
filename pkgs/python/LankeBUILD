lankebuild_build() {
    # PY_MINOR 从 {ORIG_PKG_VER}（如 3.14.6）派生 → 3.14，版本目录/命令后缀都按它
    PY_MINOR=$(printf '%s' '{ORIG_PKG_VER}' | cut -d. -f1-2)
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --enable-shared --with-system-expat --with-system-ffi --enable-optimizations --enable-loadable-sqlite-extensions --without-static-libpython
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install

    # --- 新增：清理冗余文件 ---
    # 1. 递归删除所有名为 __pycache__ 的目录
    find {STAGING_ROOT}/ -name "__pycache__" -type d -exec rm -rf {} +

    # 2. 删除 Python 自带的测试模块 (非常大，约 100MB+)
    if [ -d "{STAGING_ROOT}{LIBDIR}/python${PY_MINOR}/test" ]; then
        rm -rf {STAGING_ROOT}{LIBDIR}/python${PY_MINOR}/test
    fi
    # -----------------------

    # 添加 Python 兼容性链接
    ln -sfv python${PY_MINOR} {STAGING_ROOT}{BINDIR}/python3
    ln -sfv python3 {STAGING_ROOT}{BINDIR}/python
    ln -sfv python${PY_MINOR}-config {STAGING_ROOT}{BINDIR}/python3-config
    ln -sfv python3-config {STAGING_ROOT}{BINDIR}/python-config
    ln -sfv pydoc${PY_MINOR} {STAGING_ROOT}{BINDIR}/pydoc3
    ln -sfv idle${PY_MINOR} {STAGING_ROOT}{BINDIR}/idle3

    # --- PEP 668：外部管理标记 ---
    # 阻止 pip 直接装进系统 site-packages：python 升级后会留下孤儿 /usr/lib/python{旧版}
    # （pip 装的不随版本迁移），造成污染与玄学加载问题。系统包用 lpkg，用户包用 venv / pip --user。
    mkdir -p "{STAGING_ROOT}{LIBDIR}/python${PY_MINOR}/site-packages"
    cat > "{STAGING_ROOT}{LIBDIR}/python${PY_MINOR}/site-packages/EXTERNALLY-MANAGED" << 'EOF'
[externally-managed]
Error=This Python is externally managed by LankeOS's lpkg package manager. Install system packages with lpkg, and Python packages with a virtual environment (venv) or pip --user.
EOF

}


