lankebuild_build() {
    mkdir -p build && cd build
    meson setup .. \
        --prefix={PREFIX} \
        --buildtype=release \
        -Dcairo=disabled
    ninja -j$(nproc)
    DESTDIR="{STAGING_ROOT}" ninja install
}

