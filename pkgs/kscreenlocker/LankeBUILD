    :
}

lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_LIBEXECDIR=libexec \
        -DCMAKE_INSTALL_SYSCONFDIR={SYSCONFDIR} \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_QT5=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -W no-author ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

lankebuild_package() {
    # PAM 配置（Arch 同款命名，锁屏认证必需——kscreenlocker 用 /usr/lib/pam.d/kde 服务）
    install -dm755 {STAGING_ROOT}/usr/lib/pam.d
    install -m644 {WORK_DIR}/../kde.pam {STAGING_ROOT}/usr/lib/pam.d/kde
    install -m644 {WORK_DIR}/../kde-fingerprint.pam {STAGING_ROOT}/usr/lib/pam.d/kde-fingerprint
    install -m644 {WORK_DIR}/../kde-smartcard.pam {STAGING_ROOT}/usr/lib/pam.d/kde-smartcard
}
