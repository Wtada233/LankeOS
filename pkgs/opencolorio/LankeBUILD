lankebuild_prepare() {
    # apphelpers 是 apps 内部使用的 STATIC 库；上游无条件 install，去掉该规则
    patch -Np1 -i "{WORK_DIR}/../fix-no-static-install.patch"
}

lankebuild_build() {
    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DOCIO_BUILD_PYTHON=ON \
        -DOCIO_BUILD_APPS=ON \
        -DOCIO_BUILD_TESTS=OFF
    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} cmake --install build
}

lankebuild_package() {
    :
}
