lankebuild_prepare() {
    # tarball 无 .tarball-version 也无 git，git-version-gen 拿不到版本 → 手动写
    #（configure.ac 用 git-version-gen 读 .tarball-version 或 git describe）
    echo "{ORIG_PKG_VER}" > .tarball-version
}

lankebuild_build() {
    NOCONFIGURE=1 ./autogen.sh
    ./configure --prefix=/usr --disable-valadoc
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make -j$(nproc)
}


lankebuild_package() {
    make DESTDIR="{STAGING_ROOT}" install
}
