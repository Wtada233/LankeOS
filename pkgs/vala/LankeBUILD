lankebuild_prepare() {
    # tarball 无 .tarball-version 也无 git，git-version-gen 拿不到版本 → 手动写
    #（configure.ac 用 git-version-gen 读 .tarball-version 或 git describe）
    echo "{ORIG_PKG_VER}" > .tarball-version
}

lankebuild_build() {
    NOCONFIGURE=1 ./autogen.sh
    # glib>=2.74 的 g_get_system_data_dirs 返回 const gchar* const*，vala 预生成代码仍赋给 gchar**。
    # gcc 16 起 incompatible-pointer-types 默认是 error（Arch 的 gcc 只告警），显式降级为 warning。
    CFLAGS="-O2 -Wno-error=incompatible-pointer-types" ./configure --prefix=/usr --enable-valadoc
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make -j$(nproc)
}


lankebuild_package() {
    make DESTDIR="{STAGING_ROOT}" install
}
