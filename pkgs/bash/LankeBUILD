lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    _bashconfig=(-DDEFAULT_PATH_VALUE=\'\"/usr/local/sbin:/usr/local/bin:/usr/bin\"\'
               -DSTANDARD_UTILS_PATH=\'\"/usr/bin\"\'
               -DSYS_BASHRC=\'\"/etc/bash.bashrc\"\'
               -DSYS_BASH_LOGOUT=\'\"/etc/bash.bash_logout\"\'
               -DNON_INTERACTIVE_LOGIN_SHELLS
               -std=gnu17)
    # 注意：占位符前**不能**写 `$` —— lpkg 是字面替换，残留的 `$` 会进容器被 shell
    # 二次求值：`${-march=x86-64-v3 ...}` 被当成 shell 选项展开成 `ehBc` + 裸字面量，
    # 报 `ld: cannot find ehBcmarch=x86-64-v3`。
    export CFLAGS="{CFLAGS} ${_bashconfig[@]}"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --without-bash-malloc --with-installed-readline --with-curses --enable-readline
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
    ln -sf bash {STAGING_ROOT}{BINDIR}/sh
}


lankebuild_package() {
    # Installation handled by builder
    mkdir -p "{STAGING_ROOT}/etc/"
    cat > "{STAGING_ROOT}/etc/bash.bashrc" << 'EOF'
#
# /etc/bash.bashrc from Arch Linux
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Prevent doublesourcing
if [[ -z "${BASHRCSOURCED}" ]] ; then
  BASHRCSOURCED="Y"
  # the check is bash's default value
  [[ "$PS1" = '\s-\v\$ ' ]] && PS1='[\u@\h \W]\$ '
  case ${TERM} in
    Eterm*|alacritty*|aterm*|foot*|gnome*|konsole*|kterm*|putty*|rxvt*|tmux*|xterm*)
      PROMPT_COMMAND+=('printf "\033]0;%s@%s:%s\007" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"')
      ;;
    screen*)
      PROMPT_COMMAND+=('printf "\033_%s@%s:%s\033\\" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"')
      ;;
  esac
fi

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  . /usr/share/bash-completion/bash_completion
fi

EOF

    # 注册为合法登录 shell（/etc/shells 由各 shell 包自行维护，filesystem 只留注释模板）。
    # login/sshd 的 PAM 栈（system-login）首行是 pam_shells.so，它把 passwd 里的 pw_shell
    # 与 /etc/shells 各行做 **strcmp**（linux-pam modules/pam_shells/pam_shells.c，逐字符
    # 比对、不做 realpath），未列出的 shell 直接 PAM_AUTH_ERR —— login 报 "Login incorrect"，
    # 密码根本不会被验证。
    # /bin/sh 是本包建的 bash 软链（见 lankebuild_build 的 ln -sf）；
    # /bin 与 /usr/bin 是同一文件但比对按字符串，两个字面量都要写。
    cat > "{STAGING_HOOKS}/postinst.sh" << 'HOOK'
#!/bin/sh
for _s in /usr/bin/bash /bin/bash /usr/bin/sh /bin/sh; do
    grep -qxF "$_s" /etc/shells 2>/dev/null || echo "$_s" >> /etc/shells
done
exit 0
HOOK
    chmod +x "{STAGING_HOOKS}/postinst.sh"

    cat > "{STAGING_HOOKS}/prerm.sh" << 'HOOK'
#!/bin/sh
if [ -f /etc/shells ]; then
    sed -i -e '\|^/usr/bin/bash$|d' -e '\|^/bin/bash$|d' \
           -e '\|^/usr/bin/sh$|d' -e '\|^/bin/sh$|d' /etc/shells
fi
exit 0
HOOK
    chmod +x "{STAGING_HOOKS}/prerm.sh"
}
