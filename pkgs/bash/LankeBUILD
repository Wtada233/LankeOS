lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    _bashconfig=(-DDEFAULT_PATH_VALUE=\'\"/usr/local/sbin:/usr/local/bin:/usr/bin\"\'
               -DSTANDARD_UTILS_PATH=\'\"/usr/bin\"\'
               -DSYS_BASHRC=\'\"/etc/bash.bashrc\"\'
               -DSYS_BASH_LOGOUT=\'\"/etc/bash.bash_logout\"\'
               -DNON_INTERACTIVE_LOGIN_SHELLS
               -std=gnu17)
    export CFLAGS="${CFLAGS} ${_bashconfig[@]}"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --without-bash-malloc --with-installed-readline --with-curses --enable-readline
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
    ln -sf bash {STAGING_ROOT}{BINDIR}/sh
}


lankebuild_package() {
    # Installation handled by builder
    mkdir -p "{STAGING_ROOT}/etc/"
    cat > "{STAGING_ROOT}/etc/bash.bashrc" << 'EOF'
#
# /etc/bash.bashrc from Arch Linux
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Prevent doublesourcing
if [[ -z "${BASHRCSOURCED}" ]] ; then
  BASHRCSOURCED="Y"
  # the check is bash's default value
  [[ "$PS1" = '\s-\v\$ ' ]] && PS1='[\u@\h \W]\$ '
  case ${TERM} in
    Eterm*|alacritty*|aterm*|foot*|gnome*|konsole*|kterm*|putty*|rxvt*|tmux*|xterm*)
      PROMPT_COMMAND+=('printf "\033]0;%s@%s:%s\007" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"')
      ;;
    screen*)
      PROMPT_COMMAND+=('printf "\033_%s@%s:%s\033\\" "${USER}" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}"')
      ;;
  esac
fi

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  . /usr/share/bash-completion/bash_completion
fi

EOF
}
