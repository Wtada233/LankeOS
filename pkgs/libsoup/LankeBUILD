lankebuild_prepare() {
    mkdir -p build
}

lankebuild_build() {
    echo "Configuring libsoup-{ORIG_PKG_VER}"
    cd build
    meson setup .. --prefix={PREFIX} --sysconfdir={SYSCONFDIR}        \
                   --buildtype=release  \
                   -Ddocs=disabled      \
                   -Dtests=false        \
                   -Dsysprof=disabled   \
                   -Dbrotli=disabled
    echo "Building libsoup-{ORIG_PKG_VER}"
    ninja -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging libsoup-{ORIG_PKG_VER}"
    cd build
    DESTDIR="{STAGING_ROOT}" ninja install
    echo "Package staging complete."
}
