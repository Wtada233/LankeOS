    :
}

lankebuild_build() {
    mkdir build && cd build
    # GTK4 immodule：仓库原先只发 GTK3 那个（/usr/lib/gtk-3.0/3.0.0/immodules/im-fcitx5.so），
    # GTK4 侧 /usr/lib/gtk-4.0/4.0.0/immodules/ 一个都没有 —— GTK4 应用当时只能走 Wayland
    # text-input 协议。终端的 VTE 用 gtk_im_multicontext_new()（两条路都留着），补上 GTK4
    # 模块后可用 GTK_IM_MODULE=fcitx5 让它走 immodule 路径（值必须是 fcitx5：
    # GTK 按 im-<名字>.so 找模块）。这正是 Arch 的默认：Arch PKGBUILD 只关 GTK2，
    # makedepends 同时列了 gtk3 与 gtk4。
    # GIR：上游默认 ON（ENABLE_GIR，Arch 未覆盖），产物是 Fcitx5Gtk 的 .gir/.typelib。
    # 前提已核：gtk4 4.24.0 + gtk4-x11、gobject-introspection 1.86、gtk+-3.0 的 gir 都在。
    cmake -G Ninja .. \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_SYSCONFDIR={SYSCONFDIR} \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DENABLE_GTK2_IM_MODULE=OFF \
        -DENABLE_GTK3_IM_MODULE=ON \
        -DENABLE_GTK4_IM_MODULE=ON \
        -DENABLE_SNOOPER=ON \
        -DENABLE_GIR=ON
    DESTDIR={STAGING_ROOT} ninja install
}


lankebuild_package() {
    # GTK4 在 Wayland 下**不会**自己选输入法上下文（GTK3 会：im-wayland.so 被自动挑中），
    # 必须由 gtk-im-module 指名。该键在 GTK4 里没有 gsettings 映射（gtksettings.c 只有
    # g_param_spec_string("gtk-im-module")），实测 settings.ini 也不生效（把
    # GTK_DATA_PREFIX 下的 /usr/share 与 /etc 两份 gtk-4.0/settings.ini 的值都改成
    # "none"，探测结果不变 → 属性根本没被应用），所以机制只能是会话环境，由本包随包投递。
    # 值是冒号分隔的列表（GTK 按 ':' 切分，逐项按 backend 过滤后取第一个可用者）：
    #   wayland —— 合成器的 text-input 协议，与输入法框架无关（GTK3 的默认行为就是它；
    #     gtkimmulticontext 的 match_backend 要求 Wayland 显示且合成器宣告
    #     zwp_text_input_manager_v3，kwin ✓）；
    #   fcitx —— 本包提供的 GTK4 模块。键名用 fcitx：fcitx5-diagnose 给的就是这个值，
    #     且模块的 GIO 扩展同时注册了 fcitx 与 fcitx5 两个名字（实测枚举确认）。
    # 于是 Wayland 下走协议，拿不到协议的 backend（X11/Xwayland 里的 GTK4 应用）才落到模块。
    install -dm 755 "{STAGING_ROOT}/usr/lib/environment.d"
    cat > "{STAGING_ROOT}/usr/lib/environment.d/fcitx5-gtk.conf" << 'EOF'
GTK_IM_MODULE=wayland:fcitx
EOF
}
