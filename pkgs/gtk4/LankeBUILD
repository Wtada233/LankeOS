lankebuild_build() {
    mkdir build && cd build
    meson setup .. --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --buildtype=release       --wrap-mode=nofallback       -Dx11-backend=true       -Dwayland-backend=true       -Dvulkan=enabled       -Dbuild-demos=false       -Dbuild-tests=false       -Dbuild-examples=false       -Dbuild-testsuite=false       -Ddocumentation=false       -Dman-pages=true       -Dmedia-gstreamer=enabled       -Dcloudproviders=enabled       -Dintrospection=enabled       -Dtracker=enabled       -Dcolord=enabled       -Dsysprof=enabled       -Dprint-cups=enabled       -Dprint-cpdb=disabled
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

