lankebuild_build() {
    ./configure --prefix={PREFIX} --disable-static
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install

    install -Dm644 COPYING "{STAGING_ROOT}{DATADIR}/licenses/libidn2/COPYING"
}

