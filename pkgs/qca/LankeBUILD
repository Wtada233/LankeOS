lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX={PREFIX} -DQT6=ON -DQCA_INSTALL_IN_QT_PREFIX=ON -DBUILD_TESTS=OFF ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

