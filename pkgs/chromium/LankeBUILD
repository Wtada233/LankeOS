#
# Chromium 
# 基于 Arch Linux PKGBUILD 适配 LankeOS
# 注意：使用 /bin/sh（POSIX sh），无 bashisms

# 构建目录（{WORK_DIR} 被替换为绝对路径，dirname 取父目录）
_BD=$(dirname {WORK_DIR})

# Chromium 源码目录（处理单/多 tarball 两种情况）
if [ -d "{SRC_DIR}/chromium-{ORIG_PKG_VER}" ]; then
    _CS="{SRC_DIR}/chromium-{ORIG_PKG_VER}"
else
    _CS="{SRC_DIR}"
fi

# 系统库 unbundle 列表（空格分隔，供 replace_gn_files.py 使用）
_SYSTEM_LIBS="brotli dav1d flac fontconfig freetype harfbuzz
              libdrm libjpeg libwebp libxml libxslt
              openh264 opus zlib zstd"

# 需要删除捆绑文件的目录名（libjpeg 映射为 libjpeg_turbo）
# zlib 对应 --system-libraries 的 zlib（= 系统 zlib+minizip）：third_party/zlib 不存在
# minizip/ 子目录（155 实测），写 minizip 会让 find 空跑、bundled 头文件留在树里，
# 而库却是系统 libminizip → unz_file_info 结构体布局不一致。
_UNWANTED_DIRS="brotli dav1d flac fontconfig freetype harfbuzz
                libdrm libjpeg_turbo libwebp libxml libxslt
                openh264 opus zlib zstd"

# --- Google API key（可选，默认关闭）---
# 默认构建**不带** API key：免费配额（每日调用量）根本不够一个发行版用，带上只会把配额
# 烧光。需要的人自行开启：把自己的 AUTH 放进本包目录即可被读到。
#
#   cp ~/sec/AUTH pkgs/chromium/     # 然后正常构建
#
# AUTH 是 key=value 文本，只识别一个键（不做任何猜测式匹配，其他键一律忽略）：
#   google_api_key=<...>
# 用途：地理位置、拼写检查、翻译等需要服务端 API 的功能。
#
# farm 把整个包目录 docker cp 进容器 /work/<pkg>，而 _BD = dirname({WORK_DIR}) 就是包目录，
# 所以放这里的 AUTH 在构建期可见（和 *.patch 同一条路径）。
#
# 不处理 OAuth2 client id/secret：Chromium 89 起 Google 已不放行第三方客户端的同步
# scope（Arch 因此弃用，见 archlinux.org/news/chromium-losing-sync-support-in-early-march/），
# 自己建的客户端同样过不了，编译进去也换不来登录/同步。要登录的人走**运行期**开关：
#   chromium --oauth2-client-id=<...> --oauth2-client-secret=<...>
# 这依赖 use-oauth2-client-switches-as-default.patch（它把这两个开关注册为覆盖入口），
# 该补丁与编译期凭据无关，始终保留、别删。
# AUTH 不存在或没有该键时留空：Chromium 走无 key 构建（相关功能禁用），不报错。
_GOOG_API_KEY=""
if [ -f "$_BD/AUTH" ]; then
    _GOOG_API_KEY=$(sed -n 's/^google_api_key=//p' "$_BD/AUTH" | head -1)
    if [ -n "$_GOOG_API_KEY" ]; then
        echo "chromium: 检测到 $_BD/AUTH —— 将注入 Google API key"
    else
        echo "chromium: $_BD/AUTH 里没有 google_api_key=<...>，不注入" >&2
    fi
else
    echo "chromium: 未启用 Google API key（默认行为；如需启用见本文件顶部说明）"
fi


lankebuild_prepare() {
    unset {C,CPP,CXX,LD}FLAGS
    cd "$_CS"

    # --- 基础替换 ---
    sed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
        tools/generate_shim_headers/generate_shim_headers.py

    # https://crbug.com/893950
    # 注：155 起 <xmlMalloc>/<xmlFree> 已不在下列任何文件里（上游已修），两条 s/// 是空操作，
    # 只剩 -e '1i' 仍会在每个 .cc 头部插一行 #include <cstdlib>（无害）。留待一次成功构建后再删。
    sed -i -e 's/<xmlMalloc>/malloc/g' -e 's/<xmlFree>/free/g' \
           -e '1i #include <cstdlib>' \
        third_party/blink/renderer/core/xml/*.cc \
        third_party/blink/renderer/core/xml/parser/xml_document_parser.cc \
        third_party/libxml/chromium/*.cc

    # --- 应用补丁 ---
    # 每条先 dry-run 判别：能正向应用就应用；已应用（reverse dry-run 成功）则跳过；
    # 两者都失败说明与上游版本冲突，直接报错退出，避免产出「半补丁」的树。
    #
    # 注：devtools 的 GN 模板里有 5 处 public_inputs 声明（4 处在 group、1 处在 action）。
    # group 上的 public_inputs 要较新的 gn 才被消费——gn 20260731 会报
    # "Assignment had no effect"，20260911 正常。再遇到该错误先查 pkgs/gn 版本，别急着打补丁：
    #   rg -n '^\s*public_inputs\s*=' third_party/devtools-frontend/src/
    # 注：compiler-rt-adjust-paths.patch 已删——它把 builtins 路径指到 lib/linux/（系统 clang
    # 布局），bundled clang 用官方 multiarch 路径（lib/x86_64-unknown-linux-gnu/），留着反而错。
    for _p in \
        use-oauth2-client-switches-as-default.patch \
        chromium-138-nodejs-version-check.patch \
        increase-fortify-level.patch \
        chromium-149-drop-unknown-clang-flag.patch \
        chromium-147-revert-clang-no-lifetime-dse-flag.patch \
        chromium-145-fix-SYS_SECCOMP.patch \
        chromium-147-rust-1.95-bytemuck.patch \
        glibc-2.42-baud-rate-fix.patch \
        chromium-149-use-of-undeclared-identifier-ERROR.patch \
        chromium-150-revert-avx-flag-change.patch \
        chromium-152-unbundle-minizip-undo-unicode.patch \
        chromium-152-unbundle-opus-devtools.patch \
        chromium-153-iamf-tools-unbundled-opus.patch \
        openxr-vendored-vulkan-headers.patch; do
        if patch -Np1 --dry-run -i "$_BD/$_p" >/dev/null 2>&1; then
            patch -Np1 -i "$_BD/$_p"
        elif patch -Np1 -R --dry-run -i "$_BD/$_p" >/dev/null 2>&1; then
            echo "chromium: 跳过已应用的补丁 $_p"
        else
            echo "chromium: 补丁无法应用（与上游版本冲突）：$_p" >&2
            return 1
        fi
    done

    # --- 链接系统工具（node/jdk/gperf；rust 用内置工具链，见下） ---
    mkdir -p third_party/node/linux/node-linux-x64/bin \
             third_party/jdk/current/bin

    ln -sf /usr/bin/node third_party/node/linux/node-linux-x64/bin/
    # 找最高版本的 JDK，jdk 默认不装 /usr/bin/java
    _jdk=$(ls -d /usr/lib/jvm/java-*-openjdk 2>/dev/null | sort -V | tail -1)
    if [ -n "$_jdk" ]; then
        ln -sf "$_jdk/bin/java" third_party/jdk/current/bin/
    fi
    # dawn/tint 源码生成需要 go（build() 里 export GOROOT=/usr/lib/go）
    mkdir -p third_party/dawn/tools/golang/linux-amd64/bin
    ln -sf /usr/bin/go third_party/dawn/tools/golang/linux-amd64/bin/

    # --- 用官方脚本下载内置 rust-toolchain + clang（替代 fetch_gcs.sh）---
    # 2026年8月5日加入，修复构建；chromium 153+ 工具链锁定 git-LLVM-23/24（与 rust-toolchain
    # 一致），系统 clang 用不了，必须用 bundled clang。
    # 官方脚本直连 GCS、不需要 gclient：tools/rust/update_rust.py（rust-toolchain + VERSION）
    # + tools/clang/scripts/update.py（主 clang + cr_build_revision）。
    # 不用 fetch_gcs.sh：它手动 grep DEPS 有 object/sha 配对 bug（android-runtime 排主 clang
    # 前时 sha 错位、宽 pattern 串 key），官方脚本内部正确处理。
    ./tools/rust/update_rust.py
    ./tools/clang/scripts/update.py

    rm -f third_party/gperf/cipd/bin/gperf
    ln -sf /usr/bin/gperf third_party/gperf/cipd/bin/

    # --- 删除捆绑库（将被系统库替代的部分）---
    for _lib in $_UNWANTED_DIRS; do
        find "third_party/$_lib" -type f \
            ! -path "third_party/$_lib/chromium/*" \
            ! -path "third_party/$_lib/google/*" \
            ! -path "third_party/harfbuzz-ng/utils/hb_scoped.h" \
            ! -name '*.gn' ! -name '*.gni' ! -name '*.isolate' \
            -delete 2>/dev/null || true
    done

    # iamf_tools 原用 "include/opus.h"（靠 -Ithird_party/opus/src 解析）——已由
    # chromium-153-iamf-tools-unbundled-opus.patch 改成走 opus shim 的完整路径。
    # 下面的软链是兜底：凡 include third_party/opus/src/include/*.h 却不依赖
    # //third_party/opus（拿不到 shim include dir）的目标，仍能从源码根解析到系统头。
    # opus shim 只导出 opus.h/opus_defines.h/opus_multistream.h/opus_types.h，故多链两个无害。
    mkdir -p third_party/opus/src/include
    for _oph in opus.h opus_defines.h opus_types.h opus_custom.h opus_multistream.h opus_projection.h; do
        ln -sf "/usr/include/opus/$_oph" "third_party/opus/src/include/$_oph"
    done

    ./build/linux/unbundle/replace_gn_files.py --system-libraries $_SYSTEM_LIBS

    # 生成 dawn commit hash（tarball 已自带，仅在有必要时覆盖）
    if [ -d third_party/dawn/.git ]; then
        python3 build/util/lastchange.py -m DAWN_COMMIT_HASH \
            -s third_party/dawn --revision gpu/webgpu/DAWN_VERSION \
            --header gpu/webgpu/dawn_commit_hash.h
    fi
}


lankebuild_build() {
    unset {C,CPP,CXX,LD}FLAGS
    # --- 构建 chromium-launcher ---
    make -C "{SRC_DIR}"/chromium-launcher-* -j$(nproc)

    # --- 构建 Chromium ---
    cd "$_CS"

    # unbundle 工具链读 CC/CXX 环境变量——必须指向 bundled clang（git-LLVM-23）。
    # 系统 clang 22 的 resource dir 缺 cfi_ignorelist，且 LLVM 版本与 rust 产物不匹配。
    export CC="$PWD/third_party/llvm-build/Release+Asserts/bin/clang"
    export CXX="$PWD/third_party/llvm-build/Release+Asserts/bin/clang++"
    export AR="$PWD/third_party/llvm-build/Release+Asserts/bin/llvm-ar"
    export NM="$PWD/third_party/llvm-build/Release+Asserts/bin/llvm-nm"
    export RUSTC_BOOTSTRAP=1
    # dawn/tint 生成器调 third_party/dawn/tools/golang/.../bin/go（symlink 到系统 go）
    export GOROOT=/usr/lib/go

    # 移除与 Chromium ThinLTO 冲突的 CFLAGS
    for _flag in "-g" "-fexceptions" "-fcf-protection" \
                 "-fstack-clash-protection" "-Wp,-D_GLIBCXX_ASSERTIONS"; do
        CFLAGS=$(echo "$CFLAGS" | sed "s|$_flag||g")
        CXXFLAGS=$(echo "$CXXFLAGS" | sed "s|$_flag||g")
    done
    CFLAGS=$(echo "$CFLAGS" | sed 's/  */ /g')
    CXXFLAGS=$(echo "$CXXFLAGS" | sed 's/  */ /g')

    CFLAGS="$CFLAGS -Wno-builtin-macro-redefined -Wno-unknown-warning-option"
    CXXFLAGS="$CXXFLAGS -Wno-builtin-macro-redefined -Wno-unknown-warning-option"
    CPPFLAGS="$CPPFLAGS -D__DATE__= -D__TIME__= -D__TIMESTAMP__="

    # GN 构建参数（空格分隔字符串，gn 解析为列表）
    _flags=""
    _flags="$_flags custom_toolchain=\"//build/toolchain/linux/unbundle:default\""
    _flags="$_flags host_toolchain=\"//build/toolchain/linux/unbundle:default\""
    _flags="$_flags is_official_build=true symbol_level=0"
    _flags="$_flags treat_warnings_as_errors=false fatal_linker_warnings=false"
    _flags="$_flags disable_fieldtrial_testing_config=true"
    _flags="$_flags blink_enable_generated_code_formatting=false"
    _flags="$_flags ffmpeg_branding=\"Chrome\" proprietary_codecs=true"
    _flags="$_flags rtc_use_pipewire=true link_pulseaudio=true"
    _flags="$_flags use_custom_libcxx=true use_sysroot=false"
    _flags="$_flags use_system_libffi=true enable_hangout_services_extension=true"
    _flags="$_flags enable_widevine=true"
    _flags="$_flags use_qt5=false use_qt6=false use_clang_modules=false"
    # clang：内置（third_party/llvm-build，git-LLVM-23，与 rust-toolchain 一致；版本从 cr_build_revision 读）
    _flags="$_flags clang_use_chrome_plugins=false"
    _flags="$_flags chrome_pgo_phase=0"
    # rust：内置工具链（use_chromium_rust_toolchain，rust_sysroot_absolute 留空即默认），
    # 版本/绑定由 third_party/rust-toolchain 的 VERSION 文件与 crubit 自动提供
    _flags="$_flags icu_use_data_file=false"

    # Google API key（编译进 GOOGLE_API_KEY 宏，见 google_apis/BUILD.gn）
    if [ -n "$_GOOG_API_KEY" ]; then
        _flags="$_flags google_api_key=\"$_GOOG_API_KEY\""
    fi

    # 使用系统 gn（需先安装 pkgs/gn）
    gn gen out/Release --args="$_flags"

    # Chromium 构建极耗内存，留出 4 核给系统
    _nc=$(nproc)
    if [ "$_nc" -gt 4 ]; then
      _jobs=$((_nc - 4))
    else
      _jobs=1
    fi
    ninja -C out/Release -j$_jobs chrome chrome_sandbox chromedriver.unstripped
}


lankebuild_package() {
    # --- launcher ---
    cd "{SRC_DIR}"/chromium-launcher-*
    make PREFIX=/usr DESTDIR="{STAGING_ROOT}" install
    install -Dvm644 LICENSE \
        "{STAGING_ROOT}/usr/share/licenses/chromium/LICENSE.launcher"

    # --- Chromium 二进制 ---
    cd "$_CS"

    install -Dv out/Release/chrome \
        "{STAGING_ROOT}/usr/lib/chromium/chromium"
    install -Dv out/Release/chromedriver.unstripped \
        "{STAGING_ROOT}/usr/bin/chromedriver"
    install -Dvm4755 out/Release/chrome_sandbox \
        "{STAGING_ROOT}/usr/lib/chromium/chrome-sandbox"

    # --- 兼容 symlink ---
    ln -sf chromium "{STAGING_ROOT}/usr/bin/chromium-browser"

    # --- 桌面文件 / man page / appdata ---
    install -Dvm644 chrome/installer/linux/common/desktop.template \
        "{STAGING_ROOT}/usr/share/applications/chromium.desktop"
    install -Dvm644 chrome/app/resources/manpage.1.in \
        "{STAGING_ROOT}/usr/share/man/man1/chromium.1"

    sed -i \
        -e 's/@@MENUNAME/Chromium/g' \
        -e 's/@@PACKAGE/chromium/g' \
        -e 's/@@usr_bin_symlink_name/chromium/g' \
        -e 's|@@uri_scheme|x-scheme-handler/chromium;|g' \
        -e 's/@@desktop_icon/chromium/g' \
        -e 's|@@desktop_exec|/usr/bin/chromium|g' \
        -e 's/@@startup_wm_class/chromium/g' \
        -e 's/@@extra_desktop_entries//g' \
        "{STAGING_ROOT}/usr/share/applications/chromium.desktop" \
        "{STAGING_ROOT}/usr/share/man/man1/chromium.1"

    # AppData
    _tmpl=chrome/installer/linux/common/appdata.xml.template
    _info=chrome/installer/linux/common/chromium-browser.info
    . "$_info"
    PACKAGE=chromium
    export $(grep -o '^[A-Z_]*' "$_info")
    sed -E -e 's/@@([A-Z_]*)/${\1}/g' -e '/<update_contact>/d' "$_tmpl" | \
        envsubst | install -Dvm644 /dev/stdin \
        "{STAGING_ROOT}/usr/share/metainfo/chromium.appdata.xml"

    # --- 资源文件 ---
    for _f in \
        chrome_100_percent.pak chrome_200_percent.pak \
        chrome_crashpad_handler resources.pak v8_context_snapshot.bin \
        libEGL.so libGLESv2.so libvk_swiftshader.so libvulkan.so.1 \
        vk_swiftshader_icd.json; do
        cp "out/Release/$_f" "{STAGING_ROOT}/usr/lib/chromium/"
    done

    install -Dvm644 -t "{STAGING_ROOT}/usr/lib/chromium/locales" \
        out/Release/locales/*.pak

      # --- 图标 ---
    for _s in 16 32 24 48 64 128 256; do
        _src="chrome/app/theme/default_100_percent/chromium/product_logo_${_s}.png"
        [ -f "$_src" ] || _src="chrome/app/theme/chromium/product_logo_${_s}.png"
        install -Dvm644 "$_src" \
            "{STAGING_ROOT}/usr/share/icons/hicolor/${_s}x${_s}/apps/chromium.png"
    done

    # --- 许可证 ---
    install -Dvm644 LICENSE "{STAGING_ROOT}/usr/share/licenses/chromium/LICENSE"
}
