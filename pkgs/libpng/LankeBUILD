lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}


lankebuild_package() {
    # Installation handled by builder
    rm "{STAGING_ROOT}"/usr/lib/*.la # 删除libtool归档，不知道为啥lpkg没有自动处理，可能是断链
}
