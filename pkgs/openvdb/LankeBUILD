lankebuild_prepare() {
    _patch="{WORK_DIR}/../2200.patch"
    echo "openvdb patch: $_patch (cwd=$(pwd))" >&2
    if patch -Np1 --dry-run -i "$_patch"; then
        patch -Np1 -i "$_patch"
    elif patch -R -p1 --dry-run -i "$_patch"; then
        echo "TBB 2023 兼容补丁已应用，跳过"
    else
        echo "TBB 2023 兼容补丁应用失败: $_patch (cwd=$(pwd))" >&2
        exit 1
    fi

    cmake -B build -G Ninja -S . \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_IMATH_HALF=ON \
        -DUSE_LOG4CPLUS=ON \
        -DUSE_NANOVDB=ON \
        -DOPENVDB_CORE_STATIC=OFF \
        -DOPENVDB_BUILD_PYTHON_MODULE=OFF \
        -DOPENVDB_BUILD_DOCS=OFF \
        -DOPENVDB_BUILD_UNITTESTS=OFF
}

lankebuild_build() {
    ninja -C build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" ninja -C build install
}
