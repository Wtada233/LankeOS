lankebuild_prepare() {
    cargo fetch --locked
}

lankebuild_build() {
    # embedded libheif is a static C++ library; lld cannot read GCC LTO bitcode without fat objects
    export CFLAGS="$CFLAGS -ffat-lto-objects"
    export CXXFLAGS="$CXXFLAGS -ffat-lto-objects"
    # link the system libjpeg-turbo instead of building the bundled copy
    export TURBOJPEG_SOURCE=pkg-config
    export TURBOJPEG_DYNAMIC=1
    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"
    just build-release --frozen
}

lankebuild_package() {
    just rootdir="{STAGING_ROOT}" install
    install -Dm644 LICENSE "{STAGING_ROOT}/usr/share/licenses/cosmic-viewer/LICENSE"
}
