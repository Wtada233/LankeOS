lankebuild_build() {
    mkdir build
    cd build
    meson setup .. \
        --prefix={PREFIX} \
        --buildtype=release \
        -D introspection=enabled \
        -D man=false \
        -D glycin=disabled
    ninja -j$(nproc)
    
    DESTDIR={STAGING_ROOT} ninja install
}
