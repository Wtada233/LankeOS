lankebuild_prepare() {
    # 用上游 CMake 构建：除了共享库和 libzstd.pc，还生成 CMake 包配置
    # （zstdConfig.cmake / zstdTargets.cmake），OpenImageIO 等 CMake 消费者
    # 走 find_package(zstd CONFIG) 时需要它。
    cmake -B build -G Ninja -S build/cmake \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DZSTD_BUILD_STATIC=OFF \
        -DZSTD_BUILD_TESTS=OFF \
        -DZSTD_BUILD_CONTRIB=OFF \
        -DZSTD_PROGRAMS_LINK_SHARED=ON
}

lankebuild_build() {
    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja -C build install
}

lankebuild_package() {
    # Installation handled by builder
    :
}
