lankebuild_prepare() {
    # Prepare environment
    meson setup _build --prefix=/usr --buildtype=release --wrap-mode nofallback --libexecdir=lib     -Dcompose=true -D docs=false -D apidocs=false -D man=false -Dqt=true
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}


lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
}
