lankebuild_prepare() {
    # tarball 不含 submodule，从固定 hash 恢复 kenlm（kenlm 无发布系统，固定 pin）
    # 先删 tarball 里的 gitlink 空目录，否则 mv 会把它挪进空目录里
    rm -rf libime-{ORIG_PKG_VER}/src/libime/core/kenlm
    mv "{WORK_DIR}/kenlm-bcd4af619a2fa45f5876d8855f7876cc09f663af" libime-{ORIG_PKG_VER}/src/libime/core/kenlm
}

lankebuild_build() {
    cd libime-{ORIG_PKG_VER}

    cmake -G Ninja -B build \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_SYSCONFDIR={SYSCONFDIR} \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_TEST=OFF \
        -DCMAKE_CXX_FLAGS='-w'

    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja -C build install
}


lankebuild_package() {
    # Installation handled by builder
    :
}
