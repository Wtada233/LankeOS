lankebuild_build() {
    # git clone 是单目录，lpkg 已在仓库根

    cmake -G Ninja -B build \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_SYSCONFDIR={SYSCONFDIR} \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_TEST=OFF \
        -DCMAKE_CXX_FLAGS='-w'

    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja -C build install
}


