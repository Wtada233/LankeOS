lankebuild_prepare() {
    for patchfile in "{WORK_DIR}"/../*.patch; do
        patch -Np1 -i "$patchfile"
    done
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --localstatedir={LOCALSTATEDIR} --disable-static
}

lankebuild_build() {
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}

lankebuild_package() {
    :
}
