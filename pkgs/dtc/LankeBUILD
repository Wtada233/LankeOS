lankebuild_prepare() {
    # 上游 libfdt.i 仍用 Python 2 C API 的手写 typemap；换成 Python 3 等价物
    patch -Np1 -i "{WORK_DIR}/../fix-python3-typemaps.patch"
}

lankebuild_build() {
    meson setup build \
        --prefix={PREFIX} \
        --buildtype=release \
        -Ddefault_library=shared \
        -Dpython=enabled \
        -Dvalgrind=disabled \
        -Dtests=false
    ninja -C build
    DESTDIR={STAGING_ROOT} ninja -C build install
}

lankebuild_package() {
    find "{STAGING_ROOT}" \( -name __pycache__ -o -name '*.py[co]' \) -prune -exec rm -rf {} +
}
