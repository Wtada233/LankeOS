lankebuild_prepare() {
    # Download bootstrap JDK — 自动匹配 ORIG_PKG_VER 的 major，取 temurin<major>-binaries 最新 tag 的 x64 hotspot JDK
    # （避免版本升级后仍用旧 major 的 boot JDK，如以后做 openjdk30 会自动用 temurin30）
    MAJOR=$(printf '%s' "{ORIG_PKG_VER}" | grep -oE '^[0-9]+')
    BOOT_JDK_DIR="/tmp/openjdk${MAJOR}-boot-jdk"
    if [ ! -d "$BOOT_JDK_DIR" ]; then
        BOOT_URL=$(curl -fsSL "https://api.github.com/repos/adoptium/temurin${MAJOR}-binaries/releases/latest" \
                   | grep -oP '"browser_download_url": *"\K[^"]+' \
                   | grep -E '\-jdk_x64_linux_hotspot' \
                   | grep -vE 'debugimage|testimage|\.sha256|\.json|\.sig' \
                   | head -1)
        test -n "$BOOT_URL" || { echo "无法获取 temurin${MAJOR} boot JDK"; exit 1; }
        echo "=> boot JDK（JDK ${MAJOR} 最新）: $BOOT_URL"
        wget -q "$BOOT_URL" -O /tmp/boot-jdk.tar.gz
        mkdir -p "$BOOT_JDK_DIR"
        tar -xzf /tmp/boot-jdk.tar.gz -C "$BOOT_JDK_DIR" --strip-components=1
        rm -f /tmp/boot-jdk.tar.gz
    fi
}

lankebuild_build() {
    local MAKEFLAG_J=$(echo "{MAKEFLAGS}" | sed -En 's/.*-j([0-9]+).*/\1/p')
    export MAKEFLAGS=${MAKEFLAGS/-j${MAKEFLAG_J}/}

    local _CFLAGS="${CFLAGS//-O2/-O3} ${CPPFLAGS} -fcommon"
    local _CXXFLAGS="${CXXFLAGS//-O2/-O3} ${CPPFLAGS} -fcommon"
    local _LDFLAGS="{LDFLAGS}"

    _CFLAGS=${_CFLAGS/-fexceptions/}
    _CXXFLAGS=${_CXXFLAGS/-fexceptions/}
    unset CFLAGS
    unset CXXFLAGS
    unset LDFLAGS

    bash configure \
        --with-boot-jdk="$BOOT_JDK_DIR" \
        --with-stdc++lib=dynamic \
        --with-jvm-features="zgc,shenandoahgc" \
        --with-native-debug-symbols=none \
        --enable-unlimited-crypto \
        --disable-warnings-as-errors \
        --with-libjpeg=system \
        --with-giflib=system \
        --with-libpng=system \
        --with-lcms=system \
        --with-zlib=system \
        --with-harfbuzz=system \
        --with-freetype=system \
        --with-vendor-name="LankeOS" \
        --enable-linkable-runtime \
        --with-extra-ldflags="-Wl,-s" \
        --with-extra-cflags="${_CFLAGS}" \
        --with-extra-cxxflags="${_CXXFLAGS}" \
        --with-extra-ldflags="${_LDFLAGS}" \
        --with-version-string="{ORIG_PKG_VER}"

    make images
    find "build/linux-x86_64-server-release/images/jdk" -iname '*.so' -exec chmod +x {} \;
}
lankebuild_package() {
    mkdir -p "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk"
    cp -a "build/linux-x86_64-server-release/images/jdk"/bin "build/linux-x86_64-server-release/images/jdk"/lib "build/linux-x86_64-server-release/images/jdk"/include \
          "build/linux-x86_64-server-release/images/jdk"/release \
          "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/"

    mkdir -p "{STAGING_ROOT}/etc/java-25-openjdk"
    cp -r "build/linux-x86_64-server-release/images/jdk"/conf/* "{STAGING_ROOT}/etc/java-25-openjdk/"
    rm -rf "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/conf"
    ln -sfv ../../../../etc/java-25-openjdk "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/conf"

    mkdir -p "{STAGING_ROOT}{DATADIR}/licenses/openjdk25"
    cp -r "build/linux-x86_64-server-release/images/jdk"/legal/* "{STAGING_ROOT}{DATADIR}/licenses/openjdk25/"
    rm -rf "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/legal"
    ln -sfv ../../../share/licenses/openjdk25 "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/legal"

    for f in "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/bin/"*; do
        name=$(basename "$f")
        man="build/linux-x86_64-server-release/images/jdk/../jdk/man/man1/${name}.1"
        if [ -f "$man" ]; then
            mkdir -p "{STAGING_ROOT}{MANDIR}/man1"
            cp "$man" "{STAGING_ROOT}{MANDIR}/man1/${name}-openjdk25.0"
        fi
    done
    rm -rf "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/man"
    rm -rf "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/lib/src.zip"
    ln -sfv ../../../share/man "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/man"

    # 创建 /usr/bin/* → /usr/lib/jvm/java-25-openjdk/bin/* 软链接（相对路径）
    mkdir -p "{STAGING_ROOT}/usr/bin"
    for f in "{STAGING_ROOT}{LIBDIR}/jvm/java-25-openjdk/bin/"*; do
        name=$(basename "$f")
        ln -sfv "../lib/jvm/java-25-openjdk/bin/$name" \
            "{STAGING_ROOT}/usr/bin/$name"
    done
}
