lankebuild_prepare() {
    cargo fetch --locked
}

lankebuild_build() {
    # GitHub archives carry no git metadata; vergen reads these values from the environment
    export VERGEN_GIT_SHA="epoch-{ORIG_PKG_VER}"
    export VERGEN_GIT_COMMIT_DATE="1970-01-01"
    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"
    just build-release --frozen
}

lankebuild_package() {
    just rootdir="{STAGING_ROOT}" install
    install -Dm644 LICENSE "{STAGING_ROOT}/usr/share/licenses/cosmic-player/LICENSE"
}
