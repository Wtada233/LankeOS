lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static --with-python
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}


lankebuild_package() {
    find "{STAGING_ROOT}" \( -name __pycache__ -o -name '*.py[co]' \) -prune -exec rm -rf {} +
}
