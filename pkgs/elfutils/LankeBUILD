lankebuild_build() {
    ./configure \
        --prefix={PREFIX} \
        --sysconfdir={SYSCONFDIR} \
        --program-prefix="eu-" \
        --enable-deterministic-archives \
        --enable-maintainer-mode \
        --disable-libdebuginfod \
        --disable-debuginfod
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}

