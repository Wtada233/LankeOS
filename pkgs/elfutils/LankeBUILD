lankebuild_prepare() {
    :
}

lankebuild_build() {
    ./configure \
        --prefix={PREFIX} \
        --sysconfdir={SYSCONFDIR} \
        --program-prefix="eu-" \
        --enable-deterministic-archives \
        --enable-maintainer-mode \
        --disable-libdebuginfod \
        --disable-debuginfod
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}

lankebuild_package() {
    # 关静态库：elfutils configure 无 --disable-static（非 libtool），libelf/libdw/libasm 的 .a 固定安装——
    # 下游用 .so/.pc，删掉安全
    find {STAGING_ROOT} -name '*.a' -delete
}
