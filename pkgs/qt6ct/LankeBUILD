lankebuild_prepare() {
    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr
}

lankebuild_build() {
    ninja -C build -j$(nproc)
}


lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" ninja -C build install

    # 不写全局 QT_QPA_PLATFORMTHEME=qt6ct：portal 后端也是 Qt 程序，qt6ct
    # 会连带加载 libqxdgdesktopportal，在启动时反查 portal Settings，与尚未
    # 注册的 front-end 互等 25 秒。需要时由用户在应用级设置。
}
