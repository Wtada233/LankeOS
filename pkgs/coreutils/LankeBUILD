lankebuild_build() {
    autoreconf -fv
    automake -af
    FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static --enable-no-install-program=kill,uptime
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}


