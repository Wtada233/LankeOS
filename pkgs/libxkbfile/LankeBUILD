# libxkbfile 1.2.0 起从 autotools 迁移到 meson（tar 里只有 meson.build，无 configure）。
lankebuild_prepare() {
    # Prepare environment
    meson setup _build --prefix={PREFIX} --buildtype=release
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
}
