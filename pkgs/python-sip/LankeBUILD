lankebuild_prepare() {
    :
}
lankebuild_build() {
    # sip 是 python 构建工具（pyproject 打包）
    python -m build --wheel --no-isolation
    python -m installer --destdir={STAGING_ROOT} dist/*.whl
}
lankebuild_package() {
    # 清理 __pycache__（与其他 python 配方一致）
    find {STAGING_ROOT}/ -name "__pycache__" -type d -exec rm -rf {} +
}
