#
# colord — 色彩管理守护进程 + libcolord（gcc/gsd/mutter 用）。
# daemon_user=colord / libcolordcompat / vapi 同 Arch。docs(gtk-doc/man) 默认留。
# print_profiles 关：它 find_program('colprof')，要 argyllcms（本地无，属缺依赖）。
# sane/argyllcms_sensor 默认关未开。
# 注：运行时需 colord 用户（systemd-sysusers）——缺则 validate/跑 daemon 时补。

lankebuild_prepare() {
    meson setup _build --prefix=/usr --buildtype=release \
        -D daemon_user=colord \
        -D libcolordcompat=true \
        -D print_profiles=false \
        -D vapi=true
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
    # sysusers.d/colord-sysusers.conf 的 colord 用户需 postinst 建（rtkit 同款）
    cat > {STAGING_HOOKS}/postinst.sh <<'EOF'
#!/bin/sh
systemd-sysusers
systemd-tmpfiles --create
exit 0
EOF
}
