lankebuild_prepare() {
    mkdir -p build
}

lankebuild_build() {
    echo "Configuring libsecret-{ORIG_PKG_VER}"
    cd build
    meson setup .. --prefix={PREFIX} --sysconfdir={SYSCONFDIR}        \
                   --buildtype=release  \
                   -Dgtk_doc=false      \
                   -Dmanpage=false      \
                   -Dintrospection=true \
                   -Dvapi=false         \
                   -Dcrypto=gnutls
    echo "Building libsecret-{ORIG_PKG_VER}"
    ninja -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging libsecret-{ORIG_PKG_VER}"
    cd build
    DESTDIR="{STAGING_ROOT}" ninja install
    echo "Package staging complete."
}
