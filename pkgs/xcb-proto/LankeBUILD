lankebuild_prepare() {
    cd "{SRC_DIR}"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --localstatedir={LOCALSTATEDIR} \
        --disable-static 
}
lankebuild_build() {
    cd "{SRC_DIR}"
    make -j$(nproc)
}
lankebuild_package() {
    cd "{SRC_DIR}"
    make DESTDIR="{STAGING_ROOT}" install
    # 清理 __pycache__（与 python 配方一致，.pyc 冗余）
    find {STAGING_ROOT}/ -name "__pycache__" -type d -exec rm -rf {} +
}
