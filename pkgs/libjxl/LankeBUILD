lankebuild_prepare() {
    # 上游把仅工具使用的 jxl_extras_codec 静态库无条件 install；去掉该 install 规则
    patch -Np1 -i "{WORK_DIR}/../fix-no-static-install.patch"
}

lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX={PREFIX} -DJPEGXL_ENABLE_BENCHMARK=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF -DJPEGXL_ENABLE_TOOLS=ON -DJPEGXL_ENABLE_MANPAGES=OFF -DJPEGXL_ENABLE_OPENEXR=OFF -DJPEGXL_ENABLE_SJPEG=OFF -DJPEGXL_ENABLE_SKCMS=OFF -DBUILD_TESTING=OFF -DJPEGXL_WARNINGS_AS_ERRORS=OFF ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

lankebuild_package() {
    :
}
