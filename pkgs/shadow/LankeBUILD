lankebuild_prepare() {
    _arch_patch="{WORK_DIR}/../arch-distro-4.20.0-arch1.patch"
    if patch -Np1 --dry-run -i "$_arch_patch" >/dev/null 2>&1; then
        patch -Np1 -i "$_arch_patch"
    elif patch -Np1 -R --dry-run -i "$_arch_patch" >/dev/null 2>&1; then
        echo "shadow: 跳过已应用的 Arch 发行补丁"
    else
        echo "shadow: Arch 发行补丁无法应用（上游改动撞上补丁涉及的文件，需按新版重做）" >&2
        exit 1
    fi
}

lankebuild_build() {
    autoreconf -fiv

    # 2. 避免安装 Man-pages 已经提供的重复手册页（Arch 补丁已删掉被取代工具的 man 页，只剩这两处）
    find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
    find man -name Makefile.in -exec sed -i 's/passwd\.5 / /' {} \;

    # 4. 准备编译：照搬 Arch PKGBUILD 的参数；--without-su 与 Arch 一致（su 归 util-linux）。
    #    --without-audit：Arch 那边是 --with-audit，但它要求 libaudit.h，而本仓库没有 audit 包，
    #    且 configure.ac 对"显式 --with-audit + 无 libaudit.h"是 AC_MSG_ERROR（不是自动降级）→ 必须显式关。
    #    --with-btrfs：显式开（不写也因头文件在而默认开）。编译期只要内核 uapi 头
    #    （linux/{magic,btrfs_tree}.h ← pkgs/linux 的 headers_install，经 base-devel 传递带上，与 btrfs-progs 无关）；
    #    实际干活是运行时 exec `btrfs subvolume create/delete`，所以 LankeBUILD.json 的 deps 里显式写了 btrfs-progs。
    ./configure --bindir={BINDIR} \
                --disable-account-tools-setuid \
                --enable-man \
                --libdir={LIBDIR} \
                --mandir={MANDIR} \
                --prefix={PREFIX} \
                --sbindir={BINDIR} \
                --sysconfdir={SYSCONFDIR} \
                --with-btrfs \
                --with-fcaps \
                --with-group-name-max-length=32 \
                --with-libpam \
                --with-yescrypt \
                --without-audit \
                --without-bcrypt \
                --without-libbsd \
                --without-nscd \
                --without-selinux \
                --without-su \
                --disable-static

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make -j$(nproc)

    make DESTDIR="{STAGING_ROOT}" install
    make DESTDIR="{STAGING_ROOT}" -C man install

    # license
    install -vDm 644 COPYING -t "{STAGING_ROOT}/usr/share/licenses/{PKG_NAME}/"
    install -vDm 644 "{WORK_DIR}"/../LICENSE "{STAGING_ROOT}/usr/share/licenses/{PKG_NAME}/0BSD.txt"

    # custom useradd(8) defaults (not provided by upstream)
    install -vDm 600 "{WORK_DIR}"/../useradd.defaults "{STAGING_ROOT}/etc/default/useradd"
}


lankebuild_package() {
    # Installation handled by builder
    :
}
