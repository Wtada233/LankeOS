lankebuild_prepare() {
    # git src：lpkg 的 libgit2 clone v<tag> 已 --recurse-submodules，
    # 3rdparty/* 子模块（Vulkan-Headers/fast_float/glad/jinja/markupsafe/nuklear）已在对应提交就位
    :
}

lankebuild_build() {
    # git clone 是单目录，lpkg 已在仓库根目录
    meson setup build \
        --prefix={PREFIX} \
        --buildtype=release \
        -Ddefault_library=shared \
        -Dtests=false \
        -Ddemos=false
    ninja -C build
    DESTDIR={STAGING_ROOT} ninja -C build install
}

