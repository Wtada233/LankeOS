lankebuild_prepare() {
    meson setup _build --prefix=/usr --buildtype=release
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
    install -Dm644 LICENSE "{STAGING_ROOT}/usr/share/licenses/cosmic-sound-theme/LICENSE"
}
