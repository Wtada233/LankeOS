lankebuild_build() {
    # glew Makefile 默认 GLEW_DEST=/usr/local → 显式 /usr
    make -j$(nproc) STRIP= GLEW_DEST={PREFIX}
    DESTDIR={STAGING_ROOT} make install.all STRIP= GLEW_DEST={PREFIX}
    # 关静态库
    rm -f {STAGING_ROOT}{LIBDIR}/libGLEW.a
}

