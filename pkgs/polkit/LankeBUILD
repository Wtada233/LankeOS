lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    for patchfile in "{WORK_DIR}"/../*.patch; do
        patch -Np1 < "$patchfile"
    done
    mkdir build && cd build
    meson setup .. --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --buildtype=release -Ddefault_library=shared -Dsession_tracking=logind -Dauthfw=pam -Dintrospection=true -Dman=false
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
    chmod 4755 {STAGING_ROOT}{BINDIR}/pkexec

    # 安装 PAM 配置文件 (pkexec 和 polkit-1 共用)
    install -Dm644 /dev/stdin {STAGING_ROOT}/etc/pam.d/polkit-1 << 'PAM_EOF'
# Polkit authentication: system-auth stack
auth            include         system-auth
account         include         system-auth
password        include         system-auth
session         include         system-auth
PAM_EOF
    # pkexec 也用同一份
    ln -sf polkit-1 {STAGING_ROOT}/etc/pam.d/polkit-pkexec

    cat >> "{STAGING_HOOKS}/postinst.sh" << 'EOF'
systemd-sysusers
EOF
}


lankebuild_package() {
    # Installation handled by builder
    mkdir -p "{STAGING_ROOT}"/usr/share/polkit-1/rules.d
    cat > "{STAGING_ROOT}"/usr/share/polkit-1/rules.d/99-shutdown-nopasswd.rules << 'EOF'
polkit.addRule(function(action, subject) {
    // 匹配所有与关机、重启相关的 action
    if (action.id == "org.freedesktop.login1.power-off" ||
        action.id == "org.freedesktop.login1.power-off-multiple-sessions" ||
        action.id == "org.freedesktop.login1.power-off-ignore-inhibit" ||
        action.id == "org.freedesktop.login1.reboot" ||
        action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id == "org.freedesktop.login1.reboot-ignore-inhibit") {

        // 如果用户属于 wheel 组，直接放行
        if (subject.isInGroup("wheel")) {
            return polkit.Result.YES;
        }
    }
});
EOF
}
