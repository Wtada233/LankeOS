lankebuild_prepare() {
    :
}
lankebuild_build() {
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
    rm -f {STAGING_ROOT}{LIBDIR}/libnewt.a
}
lankebuild_package() {
    # 清理 __pycache__（与 python 配方一致，.pyc 冗余）
    find {STAGING_ROOT}/ -name "__pycache__" -type d -exec rm -rf {} +
}
