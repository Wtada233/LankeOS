#
# p7zip — 7-Zip 的命令行移植（LGPL + unRAR 例外）
# 基于 Arch Linux PKGBUILD 适配 LankeOS
# 注意：使用 /bin/sh（POSIX sh），无 bashisms

# 补丁在包目录（构建时 cwd 是源码目录，包目录 = work 的父级）
_BD=$(dirname {WORK_DIR})


lankebuild_prepare() {
    # install.sh 会对 7z.1/7za.1/7zr.1 调 gzip；LankeOS 包内 man 页保持未压缩
    # （见 tar/wget/bubblewrap），故去掉那三行。Arch 同款补丁。
    patch -Np1 -i "$_BD/do-not-gzip-man-pages.patch"

    # 以下三个是 oemcp 系列提交，v17.05 tag 里已经包含；Arch 按
    # https://github.com/p7zip-project/p7zip/issues/112 把它们**反向回退**
    # （改的是跨平台的 CPP/7zip/Archive/Zip/ZipItem.cpp，不是 Windows 专属）。
    # 三者是顺序提交，必须按 apple→cygwin→iconv 的逆序链式回退，顺序错了会失败。
    for _p in oemcp-apple oemcp-cygwin oemcp-iconv; do
        patch -Np1 -R -i "$_BD/$_p.patch"
    done
}


lankebuild_build() {
    # 按 Arch 不传 -j：p7zip 的 Makefile 非并行安全
    make OPTFLAGS="$CPPFLAGS $CFLAGS" 7z 7zr 7za
}


lankebuild_package() {
    make install \
        DEST_DIR="{STAGING_ROOT}" \
        DEST_HOME=/usr \
        DEST_MAN=/usr/share/man

    # 图形文件管理器的文档不适用（Arch 同样删除）
    rm -rf "{STAGING_ROOT}/usr/share/doc/p7zip/DOC/MANUAL/fm"

    # 许可证：指向包内已安装的文档（Arch 同款 symlink，不重复占地）
    install -d "{STAGING_ROOT}{DATADIR}/licenses/p7zip"
    ln -sf /usr/share/doc/p7zip/DOC/License.txt \
        "{STAGING_ROOT}{DATADIR}/licenses/p7zip/License.txt"
    ln -sf /usr/share/doc/p7zip/DOC/unRarLicense.txt \
        "{STAGING_ROOT}{DATADIR}/licenses/p7zip/unRarLicense.txt"
}
