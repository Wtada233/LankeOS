lankebuild_prepare() {
    # 3 个上游修复补丁（Arch 同款）：预览缺失/中键关标签/详情视图图标缺失
    for _p in dolphin-27696ee6.patch dolphin-9765915b.patch dolphin-9c652fac.patch; do
        if patch -Np1 --dry-run -i "{WORK_DIR}/../$_p" >/dev/null 2>&1; then
            patch -Np1 -i "{WORK_DIR}/../$_p"
        elif patch -R -p1 --dry-run -i "{WORK_DIR}/../$_p" >/dev/null 2>&1; then
            echo "$_p 已应用，跳过"
        else
            echo "$_p 应用失败" >&2
            exit 1
        fi
    done
}

lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -W no-author ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

lankebuild_package() {
    # Installation handled by builder
    :
}
