lankebuild_build() {
    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DOTIO_FIND_IMATH=ON \
        -DOTIO_AUTOMATIC_SUBMODULES=OFF \
        -DOTIO_DEPENDENCIES_INSTALL=OFF
    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} cmake --install build
}

