lankebuild_prepare() {
    :
}

lankebuild_build() {
    # Go 自举：用容器里已装的 golang（build_dep，GOROOT=/usr/lib/go）编译源码（Arch 同款）
    export GOARCH=amd64
    export GOAMD64=v1
    export GOROOT_FINAL=/usr/lib/go
    export GOROOT_BOOTSTRAP=/usr/lib/go
    export GOEXPERIMENT=nodwarf5
    cd src
    ./make.bash -v
}

lankebuild_package() {
    install -d {STAGING_ROOT}/usr/bin {STAGING_ROOT}/usr/lib/go \
        {STAGING_ROOT}/usr/share/doc/go \
        {STAGING_ROOT}/usr/lib/go/pkg/linux_amd64_dynlink \
        {STAGING_ROOT}/usr/lib/go/pkg/linux_amd64_race
    cp -a bin pkg src lib misc api test {STAGING_ROOT}/usr/lib/go/
    # 只 strip 交付的二进制与 toolchain（testdata 等保留，否则 go test 会坏）——Arch 同款
    strip {STAGING_ROOT}/usr/lib/go/bin/*
    strip {STAGING_ROOT}/usr/lib/go/pkg/tool/*/*
    cp -r doc/* {STAGING_ROOT}/usr/share/doc/go/
    ln -sf /usr/lib/go/bin/go {STAGING_ROOT}/usr/bin/go
    ln -sf /usr/lib/go/bin/gofmt {STAGING_ROOT}/usr/bin/gofmt
    ln -sf /usr/share/doc/go {STAGING_ROOT}/usr/lib/go/doc
    install -Dm644 VERSION {STAGING_ROOT}/usr/lib/go/VERSION
    rm -rf {STAGING_ROOT}/usr/lib/go/pkg/bootstrap
    rm -rf {STAGING_ROOT}/usr/lib/go/pkg/obj/go-build
    install -Dm644 go.env {STAGING_ROOT}/usr/lib/go/go.env
    install -Dm644 LICENSE {STAGING_ROOT}/usr/share/licenses/golang/LICENSE
}
