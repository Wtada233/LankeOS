lankebuild_prepare() {
    go mod download
}

lankebuild_build() {
    export GOPATH="{SRC_DIR}"
    export BUILDTAGS='seccomp apparmor'
    export CGO_CFLAGS="{CFLAGS}"
    export CGO_CXXFLAGS="{CXXFLAGS}"
    export CGO_LDFLAGS="{LDFLAGS}"
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"
    make runc 
}


lankebuild_package() {
    install -Dm755 runc "{STAGING_ROOT}/usr/bin/runc"
    install -Dm644 contrib/completions/bash/runc "{STAGING_ROOT}/usr/share/bash-completion/completions/runc"
}
