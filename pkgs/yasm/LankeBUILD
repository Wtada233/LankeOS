lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DYASM_BUILD_TESTS=OFF \
        ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

