lankebuild_prepare() {
    for patchfile in "{WORK_DIR}"/../*.patch; do
        patch -Np1 -i "$patchfile"
    done
    # Prepare environment
    PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr
}

lankebuild_build() {
    make -j$(nproc)
}


lankebuild_package() {
    make DESTDIR="{STAGING_ROOT}" install
    # itstool 运行时依赖 Python lxml 模块：由 deps: python-lxml 保证（不再用 postinst pip 装）。
}
