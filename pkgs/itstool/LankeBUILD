lankebuild_prepare() {
    cd itstool-*/
    patch -Np1 -i "{WORK_DIR}"/itstool-*-lxml-1.patch
    # Prepare environment
    PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr
}

lankebuild_build() {
    cd itstool-*/
    make -j$(nproc)
}


lankebuild_package() {
    cd itstool-*/
    make DESTDIR="{STAGING_ROOT}" install
    # postinst hook：itstool 依赖 Python lxml 模块（非仓库包），pip 安装。
    # 安装 itstool 的容器/主机都会执行。
    install -Dm644 /dev/null "{STAGING_HOOKS}"/postinst.sh
    cat > "{STAGING_HOOKS}"/postinst.sh << 'EOF'
python -m ensurepip
pip3 install lxml
EOF
}
