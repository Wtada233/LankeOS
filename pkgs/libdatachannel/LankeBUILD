lankebuild_prepare() {
    # git src：plog/usrsctp 子模块已随 clone --recurse-submodules 就位

    export CMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DUSE_GNUTLS=0 \
        -DUSE_NICE=0 \
        -DUSE_SYSTEM_JUICE=1 \
        -DUSE_SYSTEM_SRTP=1 \
        -DNO_EXAMPLES=1 \
        -DNO_TESTS=1 \
        -Wno-dev
}

lankebuild_build() {
    ninja -C build -j$(nproc)
}


lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" ninja -C build install
}
