lankebuild_prepare() {
    # tarball 不含子模块，从依赖的 tag tarball 恢复
    # 先删掉 tarball 里的 gitlink 空目录，否则 mv 会把它挪进空目录里
    cd libdatachannel-{ORIG_PKG_VER}
    rm -rf deps/plog deps/usrsctp
    mv "{WORK_DIR}/plog-1.1.10" deps/plog
    mv "{WORK_DIR}/usrsctp-0.9.5.0" deps/usrsctp

    export CMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DUSE_GNUTLS=0 \
        -DUSE_NICE=0 \
        -DUSE_SYSTEM_JUICE=1 \
        -DUSE_SYSTEM_SRTP=1 \
        -DNO_EXAMPLES=1 \
        -DNO_TESTS=1 \
        -Wno-dev
}

lankebuild_build() {
    cd libdatachannel-{ORIG_PKG_VER}
    ninja -C build -j$(nproc)
}


lankebuild_package() {
    cd libdatachannel-{ORIG_PKG_VER}
    DESTDIR="{STAGING_ROOT}" ninja -C build install
}
