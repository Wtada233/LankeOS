lankebuild_prepare() {
    # sdist 已包含完整文件清单；去掉 setup_requires 的 setuptools_git/sphinx
    patch -Np1 -i "{WORK_DIR}/../fix-setup-requires.patch"
}

lankebuild_build() {
    python3 -m build --wheel --no-isolation
}

lankebuild_package() {
    python3 -m installer --destdir={STAGING_ROOT} dist/*.whl
    find "{STAGING_ROOT}" -name __pycache__ -type d -exec rm -rf {} +
}
