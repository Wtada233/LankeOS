lankebuild_build() {
    meson setup build \
        --prefix={PREFIX} \
        --buildtype=release \
        -Denable-gir=true \
        -Denable-vapi=true
    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} meson install -C build
}

