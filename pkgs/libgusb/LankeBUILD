#
# libgusb — GLib 的 libusb 封装（colord 用）。
# docs 走 gi-docgen（本地不建）→ docs 关；vapi/introspection 默认开（vala/gi 在 build_deps）。

lankebuild_prepare() {
    meson setup _build --prefix=/usr --buildtype=release \
        -D docs=false
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
}
