lankebuild_prepare() {
    echo "Preparing ruby-{ORIG_PKG_VER}"
}

lankebuild_build() {
    echo "Configuring ruby-{ORIG_PKG_VER}"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR}          \
                --enable-shared        \
                --disable-install-doc  \
                --docdir={DATADIR}/doc/ruby-{ORIG_PKG_VER}
    echo "Building ruby-{ORIG_PKG_VER}"
    make -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging ruby-{ORIG_PKG_VER}"
    make DESTDIR="{STAGING_ROOT}" install
    echo "Package staging complete."
}
