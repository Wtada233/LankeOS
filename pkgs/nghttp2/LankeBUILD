lankebuild_prepare() {
    echo "Preparing nghttp2-{ORIG_PKG_VER}"
}

lankebuild_build() {
    echo "Configuring nghttp2-{ORIG_PKG_VER}"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static --enable-lib-only
    echo "Building nghttp2-{ORIG_PKG_VER}"
    make -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging nghttp2-{ORIG_PKG_VER}"
    make DESTDIR="{STAGING_ROOT}" install
    echo "Package staging complete."
}
