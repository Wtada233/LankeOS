lankebuild_prepare() {
    cd rnnoise-v0.2
    cp -r ../src ./
    cp -r ../models ./ 2>/dev/null || true
    autoreconf -isf
    ./configure --prefix=/usr --enable-x86-rtcd --disable-static
}

lankebuild_build() {
    cd rnnoise-v0.2
    make -j$(nproc)
}


lankebuild_package() {
    cd rnnoise-v0.2
    make DESTDIR="{STAGING_ROOT}" install
}
