lankebuild_prepare() {
    # Prepare environment
    meson setup _build --prefix=/usr --buildtype=release --wrap-mode nofallback
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}


lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
    # gtk-doc 的 python 工具（fixxref/mkhtml）运行时依赖 lxml/pygments：
    # 由 deps: python-lxml, python-pygments 保证（不再用 postinst pip 装）。
}
