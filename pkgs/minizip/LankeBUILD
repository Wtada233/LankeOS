#
# minizip （来自 zlib 源码的 contrib/minizip）
# 基于 zlib 的 ZIP 格式封装库，autoconf 构建，动态链接系统 zlib

lankebuild_prepare() {
    :
}

lankebuild_build() {
    cd contrib/minizip

    # 从 configure.ac 生成 configure
    autoreconf -fiv

    ./configure --prefix={PREFIX} --libdir={LIBDIR} --disable-static --enable-demos
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install

    # crypt.h 是 minizip 的内部头，不对外暴露（与 Arch 同款做法，依据 zlib PR 229
    # "minizip: don't install crypt.h"：历史上有人误 include 它）。
    # 删除是安全的：已安装的 5 个公开头没有任何一个 include crypt.h（跨文件并集只有
    # bzlib/ints/ioapi/mz64conf/unzip/zlib），全仓库唯一消费者 chromium 也不 include 它；
    # 且 minizip.pc 的 Cflags 是 -I/usr/include，不会因删它产生解析变化。
    rm -f "{STAGING_ROOT}{INCLUDEDIR}/minizip/crypt.h"

    install -Dm644 ../../LICENSE \
        "{STAGING_ROOT}{DATADIR}/licenses/minizip/LICENSE"
}

lankebuild_package() {
    :
}
