lankebuild_prepare() {
    export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
    export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

    ./configure --prefix={PREFIX}  \
            --ninja                \
            --enable-lto           \
            --shared-nghttp2       \
            --shared-openssl       \
            --shared-zlib          \
            --with-intl=system-icu \
            --shared-brotli        \
            --shared-ffi           \
            --shared-nghttp2       \
            --shared-openssl       \
            --shared-zlib          \
            --shared-zstd
}

lankebuild_build() {
    export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
    export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
    _nc=$(nproc)
    if [ "$_nc" -gt 4 ]; then
      _jobs=$((_nc - 4))
    else
      _jobs=1
    fi
    make -j$_jobs
}

lankebuild_package() {
    make DESTDIR={STAGING_ROOT} install
}
