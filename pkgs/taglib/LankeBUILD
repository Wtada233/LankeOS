lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX={PREFIX} -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

