# ibus-libpinyin — ibus 的 libpinyin 拼音引擎（给 GNOME 会话用；fcitx5 不受影响）
#
# 两个不同前缀缺一不可（缺了引擎注册得上却起不来）：
#   --libexecdir=/usr/lib/ibus-libpinyin → 引擎 + setup 脚本
#   默认 pkgdatadir=/usr/share/ibus-libpinyin → XML/引擎数据
# opencc 未开（仓库没这包，且是可选的简繁转换）；非 release 源才需要 autoreconf，这里是 release tarball。

lankebuild_prepare() {
    :
}

lankebuild_build() {
    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib/ibus-libpinyin \
        --enable-boost \
        --enable-cloud-input-mode
    make -j$(nproc)
}

lankebuild_package() {
    make DESTDIR={STAGING_ROOT} install

    # 清构建期 __pycache__：setup_libpinyin_PYTHON 是 automake 的 *_PYTHON primary，
    # 安装时必调 py-compile 生成字节码。automake 没有对应开关，py-compile 本身也不认
    # PYTHONDONTWRITEBYTECODE（它直接 py_compile.compile()，显式编译不受该变量影响）。
    # .pyc 含绝对路径、不可复现 —— 与本仓库其余 63 个包同款处理。
    find {STAGING_ROOT} -type d -name __pycache__ -prune -exec rm -rf {} +
}
