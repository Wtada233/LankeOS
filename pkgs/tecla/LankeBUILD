#
# tecla — GNOME 键盘布局查看器（gtk4/libadwaita/Wayland）。gitlab 归档 tarball，meson 默认。

lankebuild_prepare() {
    meson setup _build --prefix=/usr --buildtype=release
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
}
