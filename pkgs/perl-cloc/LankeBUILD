lankebuild_prepare() {
    :
}

lankebuild_build() {
    # cloc 是单个 Perl 脚本，上游没有 Makefile.PL；Unix/Makefile 负责语法检查
    # 与由 POD 生成 man 页。用源码 mtime 固定 man 页日期，避免产物随构建时间变化。
    export SOURCE_DATE_EPOCH=$(stat -c %Y cloc)
    make -C Unix man
}

lankebuild_package() {
    export SOURCE_DATE_EPOCH=$(stat -c %Y cloc)
    make -C Unix install DESTDIR={STAGING_ROOT} prefix={PREFIX}

    install -Dm644 LICENSE "{STAGING_ROOT}{DATADIR}/licenses/perl-cloc/LICENSE"
    # perllocal.pod 是各 perl 模块共享追加的安装记录，每包都 own → 打包冲突，删掉
    # （perl-xml-parser 同款；* 匹配 perl 版本目录）
    rm -f {STAGING_ROOT}/usr/lib/perl5/*/core_perl/perllocal.pod
}
