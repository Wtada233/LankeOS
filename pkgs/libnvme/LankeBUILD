lankebuild_prepare() {
    :
}

lankebuild_build() {
    meson setup build --prefix={PREFIX} --sysconfdir={SYSCONFDIR} -Ddocs-build=false -Dlibdbus=auto -Dpython=enabled .
    ninja -C build -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja -C build install
}

lankebuild_package() {
    find "{STAGING_ROOT}" \( -name __pycache__ -o -name '*.py[co]' \) -prune -exec rm -rf {} +
}
