#
# compiler-rt — LLVM compiler runtime libraries
# 参照 Arch Linux PKGBUILD 适配（完整构建，非仅 builtins）

lankebuild_prepare() {
    mkdir -p build-compiler-rt
}

lankebuild_build() {
    cd build-compiler-rt

    # COMPILER_RT_INSTALL_PATH 需要 LLVM major 版本（如 22），从 {ORIG_PKG_VER} 派生不写死
    CLANG_MAJOR=$(printf '%s' '{ORIG_PKG_VER}' | cut -d. -f1)

    cmake -G Ninja ../compiler-rt \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_SKIP_RPATH=ON \
        -DCOMPILER_RT_INSTALL_PATH=/usr/lib/clang/${CLANG_MAJOR}

    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install

    cd {SRC_DIR}/build-compiler-rt
    install -Dm644 ../compiler-rt/LICENSE.TXT \
        "{STAGING_ROOT}{DATADIR}/licenses/compiler-rt/LICENSE"
}

lankebuild_package() {
    :
}
