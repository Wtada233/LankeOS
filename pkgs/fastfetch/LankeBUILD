lankebuild_build() {
    mkdir build && cd build
    cmake .. -DCMAKE_INSTALL_PREFIX={PREFIX} -DENABLE_VULKAN=ON -DENABLE_WAYLAND=ON -DENABLE_DRM=ON -DENABLE_GIO=ON -DENABLE_DBUS=ON -DCMAKE_INSTALL_SYSCONFDIR={SYSCONFDIR}
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}


