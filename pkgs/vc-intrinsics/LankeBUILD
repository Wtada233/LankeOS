lankebuild_prepare() {
    cmake -B build -G Ninja -S . \
        -DCMAKE_INSTALL_PREFIX={PREFIX} \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_DIR=/usr/lib/cmake/llvm
}

lankebuild_build() {
    ninja -C build -j$(nproc)
}

lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" ninja -C build install
}
