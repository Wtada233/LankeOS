lankebuild_prepare() {
    echo "Preparing sqlite-{ORIG_PKG_VER}"
}

lankebuild_build() {
    export CPPFLAGS="$CPPFLAGS -DSQLITE_ENABLE_COLUMN_METADATA=1 -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_SECURE_DELETE -DSQLITE_ENABLE_STMTVTAB -DSQLITE_ENABLE_STAT4 -DSQLITE_MAX_VARIABLE_NUMBER=250000 -DSQLITE_MAX_EXPR_DEPTH=10000 -DSQLITE_ENABLE_MATH_FUNCTIONS"
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static --enable-session --enable-fts3 --fts4 --fts5 --rtree --soname=legacy
    make -j$(nproc)
    make -j$(nproc) dbdump dbhash dbtotxt index_usage showdb showjournal showshm \
        showstat4 showwal sqldiff sqlite3_expert sqlite3_rsync sqltclsh
}

lankebuild_package() {
    echo "Packaging sqlite-{ORIG_PKG_VER}"
    make DESTDIR="{STAGING_ROOT}" install
    install -m755 dbdump dbhash dbtotxt index_usage showdb showjournal showshm \
        showstat4 showwal sqldiff sqlite3_expert sqlite3_rsync "{STAGING_ROOT}"/usr/bin/

    install -m755 sqltclsh "{STAGING_ROOT}"/usr/bin/
    install -D -m644 LICENSE.md "{STAGING_ROOT}"/usr/share/licenses/sqlite/license.txt
    echo "Package staging complete."
}
