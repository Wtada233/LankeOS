lankebuild_prepare() {
    # COSMIC 注销只停 cosmic-session.target，graphical-session.target、portal
    # 和会话环境会留到下一个会话。补丁加 cosmic-session-shutdown.target，
    # 并在 start-cosmic 退出后停 target、清理环境。
    patch -Np1 -i "{WORK_DIR}/../0001-cosmic-session-shutdown-target.patch" \
        || patch -R --dry-run -p1 -i "{WORK_DIR}/../0001-cosmic-session-shutdown-target.patch" >/dev/null 2>&1 \
        || exit 1

    cargo fetch --locked
}

lankebuild_build() {
    export CARGO_PROFILE_RELEASE_LTO=thin
    export RUSTFLAGS="${RUSTFLAGS} -C link-arg=-fuse-ld=lld"
    cargo build --release --frozen
}

lankebuild_package() {
    just rootdir="{STAGING_ROOT}" install
    install -Dm644 LICENSE.md "{STAGING_ROOT}/usr/share/licenses/cosmic-session/LICENSE.md"
}
