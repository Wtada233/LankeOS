lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    ./bootstrap --prefix=/usr \
        --mandir=/share/man \
        --docdir=/share/doc/cmake \
        --datadir=/share/cmake \
        --system-libs \
        --no-system-cppdap \
        --no-system-libuv \
        --no-system-librhash \
        --parallel="$(nproc)"
    make -j$(nproc)
}

lankebuild_package() {
    make DESTDIR={STAGING_ROOT} install
    find {STAGING_ROOT} -name '*.a' -delete
}
