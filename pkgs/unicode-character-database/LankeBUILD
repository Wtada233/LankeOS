# unicode-character-database — Unicode 字符数据库（UCD + Unihan）
# ibus 的 emoji/unicode 字典在**构建期**读它（`--with-ucd-dir=/usr/share/unicode/`）。
#
# 两个 zip 是上游的发布形态（Arch 用 noextract 原样装 + 就地解）→ 这里放 work_sources，
# 构建期自己解到 _data/ 再整树拷进去，免得 lpkg 把几千个数据文件撒进源码目录。

_BD=$(dirname {WORK_DIR})

lankebuild_prepare() {
    mkdir -p _data
    # 文件名 = URL 的 basename（builder_executor.cpp:422 `fs::path(url).filename()`）。
    # lpkg 不支持 Arch 的「名字::URL」重命名语法（源码里对 "::" 零处理），所以这里
    # 必须用上游原始名 UCD.zip / Unihan.zip——写成带版本号的 UCD-18.0.0.zip 永远找不到。
    unzip -q "{WORK_DIR}/UCD.zip" -d _data
    unzip -q "{WORK_DIR}/Unihan.zip" -d _data
}

lankebuild_build() {
    # 纯数据包，无需编译
    :
}

lankebuild_package() {
    install -d "{STAGING_ROOT}{DATADIR}/unicode"
    cp -r _data/. "{STAGING_ROOT}{DATADIR}/unicode/"

    # Arch 同款兼容符号链接（FS#49938）：ucd/ 指向本目录，另两个历史名指向 unicode/
    ln -s . "{STAGING_ROOT}{DATADIR}/unicode/ucd"
    for x in unicode-character-database unicode-data unidata; do
        ln -s unicode "{STAGING_ROOT}{DATADIR}/$x"
    done

    install -Dm644 "$_BD/unicode-license.txt" \
        "{STAGING_ROOT}{DATADIR}/licenses/unicode-character-database/LICENSE"
}
