    :
}

lankebuild_build() {
    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-custom-modes

    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install

    # 仅保留共享库
    rm -f "{STAGING_ROOT}/{LIBDIR}/libopus".a

    install -Dm644 COPYING "{STAGING_ROOT}/{DATADIR}/licenses/opus/COPYING"
}

