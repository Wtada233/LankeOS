lankebuild_build() {
    mkdir build && cd build
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX={PREFIX} -DENABLE_ENCODER=ON -DENABLE_SDL=ON ..
    ninja -j$(nproc)
    DESTDIR={STAGING_ROOT} ninja install
}

