lankebuild_prepare() {
    # 创建构建目录并配置
    mkdir -p build
    cd build
    meson setup --prefix={PREFIX} --sysconfdir={SYSCONFDIR}            \
                --buildtype=release      \
                -D gtk_doc=false         \
                -D introspection=enabled \
                ../
    cd ..
}

lankebuild_build() {
    cd build
    meson compile -j $(nproc)
    DESTDIR="{STAGING_ROOT}" meson install
}

lankebuild_package() {
    :
}
