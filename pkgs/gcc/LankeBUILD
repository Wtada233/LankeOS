lankebuild_build() {
    # 核心工具链不需要发行版 CFLAGS（linux 同款），fortran 前端等源码有 -Werror 会告警变错误
    unset {C,CPP,CXX,LD}FLAGS
    mkdir build && cd build
    # fortran 供 coin-or 链的 blas/lapack 用（gfortran + libgfortran）
    ../configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --enable-shared --enable-threads=posix --enable-__cxa_atexit --enable-clocale=gnu --enable-languages=c,c++,fortran --disable-multilib --disable-bootstrap --with-system-zlib --disable-static
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
    ln -sfv gcc {STAGING_ROOT}{BINDIR}/cc
    ln -sfv ../bin/cpp "{STAGING_ROOT}{LIBDIR}/cpp"
    mkdir -pv "{STAGING_ROOT}{LIBDIR}/bfd-plugins"
    ln -sfv ../../libexec/gcc/x86_64-pc-linux-gnu/{ORIG_PKG_VER}/liblto_plugin.so            "{STAGING_ROOT}{LIBDIR}/bfd-plugins/liblto_plugin.so"
    rm -fv "{STAGING_ROOT}/{LIBDIR}/"*.a
}


