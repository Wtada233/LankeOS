lankebuild_build() {
    # Arch 同款 configure：自动探测可用 crypto 后端（容器有 openssl+nss → 出 openssl/nss 两后端，
    # LibreOffice 需要 xmlsec1-nss）
    # 1.3.13 默认启用 pedantic；-pedantic-errors 会把发行版 CFLAGS 的
    # -D_FORTIFY_SOURCE=3 与 xmlsec 硬化参数里的 =2 的重定义警告变成致命错误。
    ./configure --prefix={PREFIX} \
        --disable-static \
        --enable-files \
        --disable-ripemd160 \
        --disable-pedantic
    # 减少未使用共享库链接（Arch 同款）
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}

lankebuild_prepare() {
