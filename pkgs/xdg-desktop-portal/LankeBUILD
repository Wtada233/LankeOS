lankebuild_prepare() {
    for patch in "{WORK_DIR}"/../*.patch; do
        if [ -f "$patch" ]; then
            echo "Applying patch: $patch"
            patch -Np1 < "$patch"
        fi
    done

    # Prepare environment
    meson setup _build --prefix=/usr --buildtype=release -D tests=disabled
}

lankebuild_build() {
    meson compile -C _build -j$(nproc)
}


lankebuild_package() {
    DESTDIR="{STAGING_ROOT}" meson install -C _build
}
