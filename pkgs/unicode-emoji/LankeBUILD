# unicode-emoji — Unicode emoji 数据文件（ibus 的 emoji-parser 构建期读 /usr/share/unicode/emoji/）
# 三个 .txt 是**非归档**源 → 必须放 work_sources（sources 里的非归档文件不会复制到 work_root）。

_BD=$(dirname {WORK_DIR})

lankebuild_prepare() {
    :
}

lankebuild_build() {
    # 纯数据包，无需编译
    :
}

lankebuild_package() {
    install -d "{STAGING_ROOT}{DATADIR}/unicode/emoji"
    for f in sequences test zwj-sequences; do
        install -m644 "{WORK_DIR}/emoji-$f.txt" \
            "{STAGING_ROOT}{DATADIR}/unicode/emoji/emoji-$f.txt"
    done

    install -Dm644 "$_BD/unicode-license.txt" \
        "{STAGING_ROOT}{DATADIR}/licenses/unicode-emoji/LICENSE"
}
