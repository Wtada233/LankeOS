set -e

lankebuild_prepare() {
    mkdir -p build
}

lankebuild_build() {
    echo "Configuring gst-plugins-base-{ORIG_PKG_VER}"
    cd build
    meson setup .. --prefix={PREFIX} --sysconfdir={SYSCONFDIR}        \
                   --buildtype=release  \
                   -Ddoc=disabled       \
                   -Dtests=disabled     \
                   -Dintrospection=enabled \
                   -Dnls=disabled
    echo "Building gst-plugins-base-{ORIG_PKG_VER}"
    ninja -j$(nproc)
    echo "Build complete."
}

lankebuild_package() {
    echo "Packaging gst-plugins-base-{ORIG_PKG_VER}"
    cd build
    DESTDIR="{STAGING_ROOT}" ninja install

    # 清理误装的系统头文件（属于 libglvnd/mesa）
    rm -rf "{STAGING_ROOT}{INCLUDEDIR}/GL" "{STAGING_ROOT}{INCLUDEDIR}/KHR" 2>/dev/null || true

    echo "Package staging complete."
}
