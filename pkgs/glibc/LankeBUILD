lankebuild_prepare() {
    # Prepare environment
    :
}

lankebuild_build() {
    for dir in */; do
        if [ -d "$dir" ]; then
            cd "$dir"
            break
        fi
    done
    mkdir build && cd build
    echo 'rootsbindir={BINDIR}' > configparms
    # CFLAGS 里的 -Wp,-D_FORTIFY_SOURCE=3 与 glibc 自身注入的加固源宏冲突，构建会失败。
    # 剥掉它，加固改由 glibc 自己的 --enable-fortify-source 提供（与 Arch 同因同解）。
    CFLAGS=${CFLAGS/-Wp,-D_FORTIFY_SOURCE=3/}
    # CFLAGS 带 -fcf-protection，glibc 侧必须同步开 CET（--enable-cet），否则构建报错
    CC=gcc CXX=g++ ../configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-werror --enable-fortify-source --enable-cet --enable-sframe --enable-kernel=5.10 --enable-stack-protector=strong --disable-nscd libc_cv_slibdir={LIBDIR} --disable-static
    CC=gcc CXX=g++ make -j$(nproc)

    make DESTDIR={STAGING_ROOT} install

    # 修正 ldd 中的硬编码路径
    sed '/RTLDLIST=/s@/usr@@g' -i {STAGING_ROOT}{BINDIR}/ldd

    # Locales：全量，走 glibc 自己的 install-locales（LFS 同款），
    # 按 localedata/SUPPORTED 生成全部 locale 进 {LIBDIR}/locale/locale-archive
    make -C ../localedata objdir="$PWD" DESTDIR={STAGING_ROOT} install-locales
    # 添加 ld.so 兼容性链接 (Usr-Merge 规范)
    ln -sfv ../lib/ld-linux-x86-64.so.2 {STAGING_ROOT}{BINDIR}/ld.so

    # Timezone data
    tar -xf {WORK_DIR}/tzdata*.tar.gz
    ZONEINFO={STAGING_ROOT}{DATADIR}/zoneinfo
    mkdir -pv $ZONEINFO/{posix,right}
    for tz in etcetera southamerica northamerica europe africa antarctica asia australasia backward; do
        zic -L /dev/null -d $ZONEINFO $tz
        zic -L /dev/null -d $ZONEINFO/posix $tz
        zic -L leapseconds -d $ZONEINFO/right $tz
    done
    cp -v zone.tab zone1970.tab iso3166.tab $ZONEINFO
    zic -d $ZONEINFO -p America/New_York
    # 删除可选的静态库，保留编译工具链必需的
    # libc_nonshared.a / libdl.a / libpthread.a / librt.a /
    # libutil.a / libanl.a / libmcheck.a / libg.a 用于日常编译，不能删
    # libc.a / libm.a / libresolv.a 等仅用于 -static 链接，可以删
    find "{STAGING_ROOT}/{LIBDIR}" -maxdepth 1 -type f -name '*.a' \
        -not -name 'libc_nonshared.a' \
        -not -name 'libpthread_nonshared.a' \
        -not -name 'libdl.a' \
        -not -name 'libpthread.a' \
        -not -name 'librt.a' \
        -not -name 'libutil.a' \
        -not -name 'libanl.a' \
        -not -name 'libmcheck.a' \
        -not -name 'libg.a' \
        -delete
}


lankebuild_package() {
    # Config files
    cat > {STAGING_ROOT}/etc/nsswitch.conf << "EOF"
passwd: files systemd
group: files systemd
shadow: files systemd
hosts: mymachines resolve [!UNAVAIL=return] files myhostname dns
networks: files
protocols: files
services: files
ethers: files
rpc: files
EOF
    cat > {STAGING_ROOT}/etc/ld.so.conf << "EOF"
/usr/local/lib
/opt/lib
include /etc/ld.so.conf.d/*.conf
EOF
}
