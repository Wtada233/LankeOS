lankebuild_prepare() {
    :
}

lankebuild_build() {
    ./configure --prefix={PREFIX} --sysconfdir={SYSCONFDIR} --disable-static --disable-gtk-doc --enable-btrfs --libexecdir={LIBDIR} --sbindir={SBINDIR} --localstatedir={LOCALSTATEDIR}
    make -j$(nproc)
    make DESTDIR={STAGING_ROOT} install
}

lankebuild_package() {
    # tmpfiles.d 建运行时目录（systemd-tmpfiles）
    cat > {STAGING_HOOKS}/postinst.sh <<'EOF'
#!/bin/sh
systemd-tmpfiles --create
exit 0
EOF
}
