#!/bin/sh
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
echo "Welcome to LankeOS GNU/Linux (Kernel $(uname -r))"
###############################################################################
# 全局变量
###############################################################################
LABEL_BASE="LANKE_BASE"
LABEL_DATA="LANKE_DATA"
TORAM=0
LIVE=0
mkdir -p /mnt
###############################################################################
# 参数检测
###############################################################################
has_cmdline_arg()
{
    for arg in $(cat /proc/cmdline); do
        [ "$arg" = "$1" ] && return 0
    done
    return 1
}
###############################################################################
# 查找并挂载启动介质
###############################################################################
mount_boot_medium()
{
    echo "Scanning for boot medium with label: $LABEL_BASE..."
    mkdir -p /mnt/medium
    for i in 1 2 3 4 5; do
        DEV_NODE=$(findfs LABEL="$LABEL_BASE" 2>/dev/null)
        if [ -n "$DEV_NODE" ]; then
            echo "Found medium: $DEV_NODE"
            mount -t auto "$DEV_NODE" /mnt/medium 2>/dev/null
            if [ -f "/mnt/medium/live/rootfs.sfs" ]; then
                return 0
            fi
            echo "rootfs.sfs not found"
            umount /mnt/medium 2>/dev/null
        fi
        echo "Waiting device ($i/5)"
        sleep 1
    done
    echo "ERROR: Cannot find LankeOS medium"
    exec sh
}
###############################################################################
# toram逻辑
###############################################################################
setup_toram()
{
    if ! has_cmdline_arg "toram"; then
        return
    fi
    TORAM=1
    echo "Toram detected."
    mkdir -p /mnt/ram_medium
    mount -t tmpfs \
        -o size=90% \
        tmpfs \
        /mnt/ram_medium
    mkdir -p /mnt/ram_medium/live
    mkdir -p /mnt/ram_medium/boot
    echo "Copying medium into RAM..."
    cp -a /mnt/medium/* /mnt/ram_medium/
    echo "Switching medium to RAM..."
    umount /mnt/medium
    mount --move \
        /mnt/ram_medium \
        /mnt/medium
    rm -rf /mnt/ram_medium
    echo "Running from RAM."
}
###############################################################################
# 通用注入（注入内容/信息文件统一放在 modules/{name}/ 下）
# inject_module <模块名> <配置文件>... 调用 modules/inject 完成注入。
# 注：init 越装越满，新增强行内容一律写成模块，不要写回本文件。
###############################################################################
detect_user_shell()
{
    # 返回默认用户 LankeOS 的登录 shell 类型：bash 或 fish
    ushell=$(awk -F: '$1 == "LankeOS" { print $NF }' /newroot/etc/passwd 2>/dev/null)
    case "$ushell" in
        *fish) echo fish ;;
        *)     echo bash ;;
    esac
}
inject_module()
{
    # 用法: inject_module <模块名> <配置文件> [配置文件 ...]
    # 配置文件相对 /newroot；rc 类注入传 .bashrc / fish 的 config.fish
    mod="$1"
    shift
    echo "Injecting module: $mod -> $*"
    sh /modules/inject "/modules/$mod/info" "$@"
}

###############################################################################
# Live模式
###############################################################################
setup_live()
{
    LIVE=1
    echo "Entering Live mode."
    mkdir -p /mnt/tmp
    mkdir -p /newroot
    mount \
        -t tmpfs \
        -o mode=0755 \
        tmpfs \
        /mnt/tmp
    mkdir -p /mnt/tmp/upper
    mkdir -p /mnt/tmp/work
    mount \
        -t overlay \
        overlay \
        -o lowerdir=/mnt/rootfs,upperdir=/mnt/tmp/upper,workdir=/mnt/tmp/work \
        -o redirect_dir=on \
        /newroot
    if [ "$UPDATED_MODE" = "1" ]; then
        echo "Creating update marker."
        touch /newroot/.updated
        mkdir -p /newroot/mnt/data
        echo "Binding old LANKE_DATA into live environment."
        mount --move \
            /mnt/data \
            /newroot/mnt/data
    fi
    ###########################################################################
    # Live环境补丁
    ###########################################################################
    echo "Applying Live patches..."
    if [ -f "/newroot/etc/shadow" ]; then
        sed -i \
        's/^root:[^:]*:/root::/' \
        /newroot/etc/shadow
    fi
    INJECT_SHELL=$(detect_user_shell)
    if [ "$INJECT_SHELL" = "fish" ]; then
        LANKERC="home/LankeOS/.config/fish/config.fish"
    else
        LANKERC="home/LankeOS/.bashrc"
    fi
    inject_module autologin \
        etc/systemd/system/getty@tty1.service.d/autologin.conf \
        etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf
    inject_module live-notice "$LANKERC"

    if [ "$UPDATED_MODE" = "1" ]; then
        inject_module update-notice "$LANKERC"
    fi
    # containerd bind (live)
    mkdir -p /mnt/tmp/containerd
    mkdir -p /newroot/var/lib/containerd
    mount --bind /mnt/tmp/containerd /newroot/var/lib/containerd
}
###############################################################################
# 查找启动介质
###############################################################################
mount_boot_medium
###############################################################################
# 挂载 squashfs
###############################################################################
mkdir -p /mnt/rootfs
mount \
    -t squashfs \
    -o loop \
    /mnt/medium/live/rootfs.sfs \
    /mnt/rootfs
###############################################################################
# 检查启动参数
###############################################################################
if has_cmdline_arg "live"; then
    LIVE=1
fi
###############################################################################
# toram处理
###############################################################################
setup_toram
###############################################################################
# LANKE_DATA版本检测
###############################################################################
UPDATED_MODE=0
DATA_DEV=""
if [ "$LIVE" -eq 0 ]; then
    echo "Persistent mode: checking LANKE_DATA..."
    DATA_DEV=$(findfs LABEL="$LABEL_DATA" 2>/dev/null)
    if [ -n "$DATA_DEV" ]; then
        echo "Found data partition: $DATA_DEV"
        mkdir -p /mnt/data
        mount \
            "$DATA_DEV" \
            /mnt/data
        #######################################################################
        # erase参数
        #######################################################################
        if has_cmdline_arg "erase"; then
            echo "Erase requested."
            find /mnt/data \
                -mindepth 1 \
                -delete
        fi
        #######################################################################
        # 版本检查
        #######################################################################
        mkdir -p /mnt/data/upper/etc
        IMAGE_RELEASE="/mnt/rootfs/etc/lanke-release"
        CURR_RELEASE="/mnt/data/upper/etc/lanke-release-curr"
        if [ -f "$IMAGE_RELEASE" ]; then
            if [ ! -f "$CURR_RELEASE" ]; then
                echo "No release record."
                cp \
                    "$IMAGE_RELEASE" \
                    "$CURR_RELEASE"
            else
                echo "Checking release version..."
                if diff \
                    "$IMAGE_RELEASE" \
                    "$CURR_RELEASE" \
                    >/dev/null 2>&1
                then
                    echo "Release matches."
                else
                    echo "Release mismatch detected."
                    UPDATED_MODE=1
                    LIVE=1
                fi
            fi
        fi
    else
        echo "LANKE_DATA not found."
        LIVE=1
    fi
fi
###############################################################################
# 根据最终状态进入live或者persistent
###############################################################################
if [ "$LIVE" -eq 1 ]; then
    setup_live
else
    echo "Starting persistent overlay."
    mkdir -p /mnt/data/upper
    mkdir -p /mnt/data/work
    mount \
        -t overlay \
        overlay \
        -o lowerdir=/mnt/rootfs,upperdir=/mnt/data/upper,workdir=/mnt/data/work \
        -o redirect_dir=on \
        /newroot
    # containerd bind (persistent)
    mkdir -p /mnt/data/containerd
    mkdir -p /newroot/var/lib/containerd
    mount --bind /mnt/data/containerd /newroot/var/lib/containerd

fi
###############################################################################
# 注入安装器
###############################################################################
if [ "$LIVE" -eq 1 ]; then
    inject_module installer usr/bin/lanke_install
fi
###############################################################################
# 修复systemd服务
###############################################################################
mkdir -p /newroot/etc/systemd/system
ln -sf \
    /dev/null \
    /newroot/etc/systemd/system/ldconfig.service
sync
###############################################################################
# 移动必要挂载点
###############################################################################
mkdir -p /newroot/dev
mkdir -p /newroot/proc
mkdir -p /newroot/sys
mkdir -p /newroot/run
mount --move \
    /dev \
    /newroot/dev
mount --move \
    /proc \
    /newroot/proc
mount --move \
    /sys \
    /newroot/sys
###############################################################################
# 保留启动介质
###############################################################################
if [ "$TORAM" -eq 0 ]; then
    if [ "$LIVE" -eq 1 ]; then
        mkdir -p /newroot/mnt/lanke_live
        mount --move \
            /mnt/medium \
            /newroot/mnt/lanke_live
    else
        mkdir -p /newroot/mnt/base
        mount --move \
            /mnt/medium \
            /newroot/mnt/base
    fi
fi
###############################################################################
# switch_root
###############################################################################
TARGET_INIT="/sbin/init"
if [ ! -x "/newroot$TARGET_INIT" ]; then
    TARGET_INIT="/usr/bin/init"
fi
echo "Transitioning to LankeOS..."
exec switch_root \
    -c /dev/console \
    /newroot \
    "$TARGET_INIT"
