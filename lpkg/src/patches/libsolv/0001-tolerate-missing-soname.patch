+/* lpkg fork: "so:" 是 lpkg 的 SONAME 能力命名空间（见 lpkg 的 POOL_SONAME_PREFIX）。
+ * 宽松模式下，只把这类 requires 变成 weak rule，避免把普通包名依赖也一并放宽。 */
+#define LPKG_SONAME_PREFIX "so:"
+static int
+is_lpkg_soname_dep(Pool *pool, Id req)
+{
+  const char *s = pool_id2str(pool, req);
+  return s && strncmp(s, LPKG_SONAME_PREFIX, sizeof(LPKG_SONAME_PREFIX) - 1) == 0;
+}
+
+/* lpkg fork: 宽松模式。把 "so:" requires 对应的规则标成 weak（与 recommends 同一机制），
+ * 求解器可以为了满足强 job（例如升级 icu）而违反它，而不是直接无解。
+ * 只在"没有可用 provider"时放宽：
+ *   - 完全没人提供（NOTHING_PROVIDES 分支）；
+ *   - 只有已装 provider（升级会把旧 provider 换掉，正是 ABI 过渡场景）。
+ * 有可用 provider 时保持强依赖，正常解析不受影响。 */
+static void
+maybe_weaken_soname_rule(Solver *solv, Pool *pool, Repo *installed, Id req, Id *dp, int rule)
+{
+  if (rule < 0 || !solv->lpkglenient || !is_lpkg_soname_dep(pool, req))
+    return;
+  if (dp)
+    {
+      Id *dpp;
+      for (dpp = dp; *dpp; dpp++)
+        if (!installed || pool->solvables[*dpp].repo != installed)
+          return; /* 有可用 provider：保持强依赖 */
+    }
+  queue_push(&solv->weakruleq, rule);
+}
